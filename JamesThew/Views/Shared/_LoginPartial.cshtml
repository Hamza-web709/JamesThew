@using JamesThew.Authorization
<div class="jt-nav-auth">
    <a class="jt-nav-link jt-nav-membership" asp-area="" asp-controller="Membership" asp-action="Index">Membership</a>
@if (User.Identity?.IsAuthenticated == true)
{
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a class="jt-nav-link" asp-area="" asp-controller="Admin" asp-action="Index">Admin Console</a>
    }
    else
    {
        <a class="jt-nav-link" asp-area="" asp-controller="Contributions" asp-action="Index">Contribute</a>
        <a class="jt-nav-link" asp-area="" asp-controller="Contests" asp-action="MyEntries">My Entries</a>
    }
    <a class="jt-nav-link" asp-area="" asp-controller="Account" asp-action="Status">Account</a>
    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        <button class="jt-btn jt-btn-outline jt-btn-sm jt-capsule-logout-btn" type="submit">Logout</button>
    </form>
}
else
{
    <a class="jt-nav-link jt-nav-register" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
    <a class="jt-btn jt-btn-primary jt-btn-sm jt-capsule-signin-btn" asp-area="" asp-controller="Account" asp-action="Login">Sign In</a>
}
</div>
