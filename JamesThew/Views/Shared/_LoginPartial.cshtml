@using JamesThew.Authorization
<ul class="jt-nav-links ms-auto">
    <li><a class="jt-nav-link" asp-area="" asp-controller="Membership" asp-action="Index">Membership</a></li>
@if (User.Identity?.IsAuthenticated == true)
{
    <li><a class="jt-nav-link" asp-area="" asp-controller="Account" asp-action="Status">Account</a></li>
    @if (User.IsInRole(AppRoles.Admin))
    {
        <li><a class="jt-nav-link" asp-area="" asp-controller="Admin" asp-action="Index">Admin</a></li>
    }
    <li>
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button class="jt-btn jt-btn-outline jt-btn-sm" type="submit">Logout</button>
        </form>
    </li>
}
else
{
    <li><a class="jt-nav-link" asp-area="" asp-controller="Account" asp-action="Register">Register</a></li>
    <li><a class="jt-btn jt-btn-primary jt-btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Sign In</a></li>
}
</ul>

