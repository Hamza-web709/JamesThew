<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - JamesThew Culinary Portal" : "JamesThew - Master Chef Recipes & Cooking Tips")</title>
    <meta name="description" content="Explore master chef recipes, culinary secrets, knife skills, and cooking tips by James Thew. Discover both free public recipes and exclusive members-only masterclasses." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="jt-header jt-header-capsule" id="jtHeader" data-theme="dark">
        <nav class="jt-navbar" aria-label="Main Navigation">
            <a class="jt-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="jt-brand-crest">JT</span>
                <span class="jt-brand-text">
                    <span class="jt-brand-name">James Thew</span>
                    <span class="jt-brand-tag">Sanctuary</span>
                </span>
            </a>

            <button id="navbarToggleBtn" class="jt-nav-toggle" type="button" aria-expanded="false" aria-controls="navbarSupportedContent" aria-label="Toggle navigation">
                <span class="jt-toggle-line"></span>
                <span class="jt-toggle-line"></span>
            </button>

            <div id="navbarSupportedContent" class="jt-nav-collapse">
                <ul class="jt-nav-links">
                    <li><a class="jt-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="jt-nav-link" asp-area="" asp-controller="Recipes" asp-action="Index">Recipes</a></li>
                    <li><a class="jt-nav-link" asp-area="" asp-controller="Tips" asp-action="Index">Cooking Tips</a></li>
                    <li><a class="jt-nav-link" asp-area="" asp-controller="Contests" asp-action="Index">Contests</a></li>
                    <li><a class="jt-nav-link" asp-area="" asp-controller="Announcements" asp-action="Index">Announcements</a></li>
                    <li><a class="jt-nav-link" asp-area="" asp-controller="Feedback" asp-action="Index">Feedback</a></li>
                    <li><a class="jt-nav-link" asp-area="" asp-controller="Faq" asp-action="Index">FAQ</a></li>
                </ul>

                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <main id="main-content" class="jt-main-content">
        @RenderBody()
    </main>

    @if (ViewData["HideDefaultFooter"] as bool? != true)
    {
        <footer class="jt-footer">
        <div class="jt-footer-inner">
            <div>
                <h3 class="jt-footer-title">James Thew Culinary</h3>
                <p class="jt-footer-desc">
                    Sharing the art and discipline of classical gastronomy, time-honored kitchen techniques, and artisanal recipes. From weeknight staples to fine dining masterclasses.
                </p>
                <div class="mt-2">
                    <span class="jt-badge jt-badge-demo">Academic Demo Project</span>
                </div>
            </div>

            <div>
                <h4 class="jt-footer-title">Culinary Catalog</h4>
                <ul class="jt-footer-links">
                    <li><a asp-controller="Recipes" asp-action="Index">All Cookery Recipes</a></li>
                    <li><a asp-controller="Recipes" asp-action="Index" asp-route-visibility="Free">Free Public Recipes</a></li>
                    <li><a asp-controller="Recipes" asp-action="Index" asp-route-visibility="MembersOnly">Members-Only Recipes</a></li>
                    <li><a asp-controller="Tips" asp-action="Index">Chef's Cooking Tips</a></li>
                </ul>
            </div>

            <div>
                <h4 class="jt-footer-title">Community & FAQ</h4>
                <ul class="jt-footer-links">
                    <li><a asp-controller="Faq" asp-action="Index">Frequently Asked Questions</a></li>
                    <li><a asp-controller="Contests" asp-action="Index">Recipe & Tip Contests</a></li>
                    <li><a asp-controller="Announcements" asp-action="Index">Winner Announcements</a></li>
                    <li><a asp-controller="Feedback" asp-action="Index">Member Feedback</a></li>
                </ul>
            </div>

            <div>
                <h4 class="jt-footer-title">Membership & Demo</h4>
                <p class="jt-footer-desc">
                    Simulated subscription tiers: $10/month or $100/year. Demo approvals are manually processed by administrator. No real payment gateways or credit card collections.
                </p>
                <ul class="jt-footer-links">
                    <li><a asp-controller="Account" asp-action="Register">Join as Member</a></li>
                    <li><a asp-controller="Account" asp-action="Login">Member Sign In</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                </ul>
            </div>
        </div>

        <div class="jt-footer-bottom">
            <div>
                &copy; 2026 JamesThew.com. All rights reserved. Created for Aptech eProject Academic Submission.
            </div>
            <div>
                Designed with ASP.NET Core MVC &amp; Entity Framework Core.
            </div>
        </div>
    </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
