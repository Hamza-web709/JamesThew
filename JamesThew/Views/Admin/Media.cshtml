@model JamesThew.ViewModels.MediaLibraryViewModel
@{
    ViewData["Title"] = "Editorial Media Library - JamesThew Admin";
}

<div class="mb-4 pb-3 border-bottom">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Admin Dashboard</a>
            <h1 class="h2 jt-serif mt-2 mb-1">&#128444; Editorial Media Library</h1>
            <p class="text-muted small mb-0">
                Upload, inspect, and organize culinary photography and technique imagery for Chef James Thew's recipes and cooking tips.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Content" class="jt-btn jt-btn-outline jt-btn-sm">
                &larr; Editorial Catalog
            </a>
            <button type="button" class="jt-btn jt-btn-primary jt-btn-sm" data-bs-toggle="modal" data-bs-target="#uploadMediaModal">
                + Upload Image
            </button>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <strong>&#10003; Success:</strong> @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
        <strong>&#9888; Notice:</strong> @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Metrics & Search Ribbon -->
<div class="row g-3 align-items-center mb-4">
    <div class="col-md-7">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                @Model.TotalCount @(Model.TotalCount == 1 ? "Image" : "Images")
            </span>
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill">
                Storage: @Model.FormattedTotalSize
            </span>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                Path: /uploads/editorial/
            </span>
        </div>
    </div>
    <div class="col-md-5">
        <form asp-action="Media" method="get" class="d-flex gap-2">
            <input type="text" name="search" class="form-control form-control-sm" placeholder="Search by filename or dish title..." value="@Model.SearchQuery" />
            <button type="submit" class="jt-btn jt-btn-outline jt-btn-sm">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a asp-action="Media" class="jt-btn jt-btn-outline jt-btn-sm text-muted">Clear</a>
            }
        </form>
    </div>
</div>

<!-- Media Gallery Grid -->
@if (Model.Items.Count == 0)
{
    <div class="p-5 text-center bg-white rounded-4 border shadow-sm">
        <div class="display-4 text-muted mb-3">&#128444;</div>
        <h3 class="h5 jt-serif mb-2">No Media Assets Found</h3>
        <p class="text-muted small mb-4">
            @(string.IsNullOrWhiteSpace(Model.SearchQuery)
                ? "No culinary images have been uploaded yet. Upload images to attach to recipes and cooking tips."
                : $"No media files matched your query '{Model.SearchQuery}'.")
        </p>
        <button type="button" class="jt-btn jt-btn-primary jt-btn-sm" data-bs-toggle="modal" data-bs-target="#uploadMediaModal">
            Upload First Image
        </button>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model.Items)
        {
            var ext = System.IO.Path.GetExtension(item.FileName).TrimStart('.').ToUpperInvariant();
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column">
                    <div class="position-relative bg-light text-center" style="height: 180px;">
                        <img src="@item.Url" alt="@item.FileName" class="w-100 h-100 object-fit-cover" loading="lazy" />
                        <span class="position-absolute top-0 end-0 m-2 badge bg-dark bg-opacity-75 rounded-pill px-2 py-1 small">
                            @ext
                        </span>
                        @if (item.UsageCount > 0)
                        {
                            <span class="position-absolute bottom-0 start-0 m-2 badge bg-success rounded-pill px-2 py-1 small">
                                &#10003; In Use (@item.UsageCount)
                            </span>
                        }
                        else
                        {
                            <span class="position-absolute bottom-0 start-0 m-2 badge bg-secondary rounded-pill px-2 py-1 small">
                                Unused
                            </span>
                        }
                    </div>

                    <div class="card-body p-3 d-flex flex-column justify-content-between flex-grow-1">
                        <div>
                            <div class="fw-bold small text-truncate mb-1" title="@item.FileName">
                                @item.FileName
                            </div>
                            <div class="d-flex justify-content-between align-items-center text-muted small mb-2">
                                <span>@item.FormattedSize</span>
                                <span>@item.CreatedAtUtc.ToString("MMM dd, yyyy")</span>
                            </div>

                            @if (item.Usages.Count > 0)
                            {
                                <div class="mb-2 p-2 bg-light rounded-3 small">
                                    <div class="fw-semibold text-muted text-uppercase" style="font-size: 0.65rem;">Referenced by:</div>
                                    <ul class="list-unstyled mb-0" style="font-size: 0.75rem;">
                                        @foreach (var usage in item.Usages.Take(2))
                                        {
                                            <li class="text-truncate">
                                                &bull; <span class="badge bg-white text-dark border">@usage.Kind</span> @usage.Title
                                            </li>
                                        }
                                        @if (item.Usages.Count > 2)
                                        {
                                            <li class="text-muted fst-italic">+@(item.Usages.Count - 2) more item(s)</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>

                        <div class="pt-2 border-top d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" onclick="copyMediaUrl('@item.Url', this)" title="Copy URL">
                                Copy Link
                            </button>
                            <a href="@item.Url" target="_blank" class="btn btn-sm btn-outline-secondary" title="View Full Image">
                                &#128065;
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteMediaModal_@item.FileName.Replace('.', '_')" title="Delete File">
                                &#128465;
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Modal for this item -->
                <div class="modal fade" id="deleteMediaModal_@item.FileName.Replace('.', '_')" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content rounded-4 border-0 shadow">
                            <div class="modal-header border-bottom">
                                <h5 class="modal-title jt-serif text-danger">&#9888; Delete Media Asset</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                                <p class="mb-2">Are you sure you want to delete this media file from the server?</p>
                                <div class="p-3 bg-light rounded-3 font-monospace small text-break mb-3">
                                    @item.FileName (@item.FormattedSize)
                                </div>

                                @if (item.UsageCount > 0)
                                {
                                    <div class="alert alert-warning rounded-3 small mb-0">
                                        <strong>&#9888; Safe Deletion Notice:</strong> This image is currently referenced by <strong>@item.UsageCount content item(s)</strong>.
                                        Deleting this file will safely unlink the image from those recipes/tips, preventing broken images on public pages.
                                    </div>
                                }
                                else
                                {
                                    <p class="small text-muted mb-0">This image is currently not referenced by any content items and can be safely removed.</p>
                                }
                            </div>
                            <div class="modal-footer border-top">
                                <button type="button" class="jt-btn jt-btn-outline jt-btn-sm" data-bs-dismiss="modal">Cancel</button>
                                <form asp-action="DeleteMedia" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="fileName" value="@item.FileName" />
                                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                                        Confirm Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Upload Media Modal -->
<div class="modal fade" id="uploadMediaModal" tabindex="-1" aria-labelledby="uploadMediaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title jt-serif" id="uploadMediaModalLabel">&#128444; Upload Image Asset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UploadMedia" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Culinary Image File <span class="text-danger">*</span></label>
                        <input type="file" name="File" class="form-control" accept=".jpg,.jpeg,.png,.webp" required />
                        <div class="form-text small text-muted">
                            Supported file formats: <strong>JPEG (.jpg, .jpeg)</strong>, <strong>PNG (.png)</strong>, <strong>WebP (.webp)</strong>.
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 small text-muted">
                        <div class="fw-bold text-dark mb-1">&#128274; Security &amp; Storage Policies:</div>
                        <ul class="mb-0 ps-3">
                            <li>Maximum file size: <strong>5 MB</strong>.</li>
                            <li>Strict MIME and file header signature inspection enforced.</li>
                            <li>Path traversal and unsafe filenames are automatically rejected.</li>
                            <li>A cryptographically unique name is generated to avoid overwrites.</li>
                            <li>Files are stored under <code>/uploads/editorial/</code>.</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="jt-btn jt-btn-outline jt-btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="jt-btn jt-btn-primary jt-btn-sm">
                        Upload to Library
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyMediaUrl(url, btn) {
            navigator.clipboard.writeText(url).then(function() {
                var originalText = btn.innerText;
                btn.innerText = 'Copied!';
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-success');
                setTimeout(function() {
                    btn.innerText = originalText;
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-outline-secondary');
                }, 2000);
            }).catch(function(err) {
                prompt("Copy URL manually:", url);
            });
        }
    </script>
}
