@model JamesThew.ViewModels.MediaLibraryViewModel
@{
    ViewData["Title"] = "Editorial Media Library - JamesThew Admin";
}

<div class="jt-admin-page-head">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Admin Dashboard</a>
        <h1 class="h2 jt-serif mt-2 mb-1">Editorial Media Library</h1>
        <p class="text-muted small mb-0">
            Upload, inspect, and organize culinary photography and technique imagery for Chef James Thew's recipes and cooking tips.
        </p>
    </div>
    <div class="jt-admin-page-actions">
        <a asp-action="Content" class="jt-btn jt-btn-outline jt-btn-sm">Editorial Catalog</a>
        <button type="button" class="jt-btn jt-btn-primary jt-btn-sm" data-bs-toggle="modal" data-bs-target="#uploadMediaModal">
            Upload Image
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <strong>Success:</strong> @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
        <strong>Notice:</strong> @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="jt-admin-media-toolbar" aria-label="Media library summary and search">
    <div class="jt-admin-media-metrics">
        <span class="jt-admin-chip">@Model.TotalCount @(Model.TotalCount == 1 ? "Image" : "Images")</span>
        <span class="jt-admin-chip">Storage: @Model.FormattedTotalSize</span>
        <span class="jt-admin-chip">Path: /uploads/editorial/</span>
    </div>
    <form asp-action="Media" method="get" class="jt-admin-media-search">
        <label for="mediaSearchInput" class="visually-hidden">Search media by filename or dish title</label>
        <input id="mediaSearchInput" type="text" name="search" class="form-control form-control-sm" placeholder="Search by filename or dish title..." value="@Model.SearchQuery" />
        <button type="submit" class="jt-btn jt-btn-outline jt-btn-sm">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
        {
            <a asp-action="Media" class="jt-btn jt-btn-outline jt-btn-sm">Clear</a>
        }
    </form>
</section>

@if (Model.Items.Count == 0)
{
    <div class="jt-admin-empty-state">
        <h2 class="h5 jt-serif mb-2">No Media Assets Found</h2>
        <p class="text-muted small mb-4">
            @(string.IsNullOrWhiteSpace(Model.SearchQuery)
                ? "No culinary images have been uploaded yet. Upload images to attach to recipes and cooking tips."
                : $"No media files matched your query '{Model.SearchQuery}'.")
        </p>
        <button type="button" class="jt-btn jt-btn-primary jt-btn-sm" data-bs-toggle="modal" data-bs-target="#uploadMediaModal">
            Upload First Image
        </button>
    </div>
}
else
{
    <section class="jt-admin-media-grid" aria-label="Media library files">
        @foreach (var item in Model.Items)
        {
            var ext = System.IO.Path.GetExtension(item.FileName).TrimStart('.').ToUpperInvariant();
            var modalId = $"deleteMediaModal_{item.FileName.Replace('.', '_').Replace('-', '_')}";

            <article class="card jt-admin-media-card" aria-label="Media file @item.FileName">
                <div class="jt-admin-media-preview">
                    <img src="@item.Url"
                         alt="@item.FileName"
                         class="jt-admin-media-img"
                         loading="lazy"
                         title="@item.FileName"
                         onerror="this.hidden=true; this.closest('.jt-admin-media-preview').classList.add('is-unavailable');" />
                    <div class="jt-media-preview-fallback" aria-hidden="true">
                        <span>Preview unavailable</span>
                    </div>
                    <span class="jt-admin-ext-badge">@ext</span>
                    @if (item.UsageCount > 0)
                    {
                        <span class="badge bg-success jt-admin-use-badge">In Use (@item.UsageCount)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary jt-admin-use-badge">Unused</span>
                    }
                </div>

                <div class="jt-admin-media-body">
                    <div>
                        <h2 class="jt-admin-media-name" title="@item.FileName">@item.FileName</h2>
                        <dl class="jt-admin-media-meta">
                            <div>
                                <dt>Size</dt>
                                <dd>@item.FormattedSize</dd>
                            </div>
                            <div>
                                <dt>Date</dt>
                                <dd>@item.CreatedAtUtc.ToString("MMM dd, yyyy")</dd>
                            </div>
                        </dl>

                        @if (item.Usages.Count > 0)
                        {
                            <div class="jt-admin-media-usage">
                                <div class="jt-admin-usage-label">Referenced by</div>
                                <ul>
                                    @foreach (var usage in item.Usages.Take(2))
                                    {
                                        <li title="@usage.Title">
                                            <span class="jt-admin-mini-badge">@usage.Kind</span>
                                            <span>@usage.Title</span>
                                        </li>
                                    }
                                    @if (item.Usages.Count > 2)
                                    {
                                        <li class="jt-admin-more-usage">+@(item.Usages.Count - 2) more item(s)</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <div class="jt-admin-media-actions">
                        <button type="button"
                                class="jt-admin-table-action jt-admin-table-action-secondary"
                                onclick="copyMediaUrl('@item.Url', this)"
                                title="Copy public link for @item.FileName"
                                aria-label="Copy public link for @item.FileName">
                            Copy Link
                        </button>
                        <a href="@item.Url"
                           target="_blank"
                           class="jt-admin-table-action jt-admin-table-action-primary"
                           title="Open full image @item.FileName"
                           aria-label="Open full image @item.FileName">
                            Preview
                        </a>
                        <button type="button"
                                class="jt-admin-table-action jt-admin-table-action-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#@modalId"
                                title="Delete File"
                                aria-label="Delete @item.FileName">
                            Delete
                        </button>
                    </div>
                </div>
            </article>

            <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0 shadow">
                        <div class="modal-header border-bottom">
                            <h5 class="modal-title jt-serif text-danger">Delete Media Asset</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="mb-2">Are you sure you want to delete this media file from the server?</p>
                            <div class="p-3 bg-light rounded-3 font-monospace small text-break mb-3">
                                @item.FileName (@item.FormattedSize)
                            </div>

                            @if (item.UsageCount > 0)
                            {
                                <div class="alert alert-warning rounded-3 small mb-0">
                                    <strong>Safe Deletion Notice:</strong> This image is currently referenced by <strong>@item.UsageCount content item(s)</strong>.
                                    Deleting this file will safely unlink the image from those recipes/tips, preventing broken images on public pages.
                                </div>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">This image is currently not referenced by any content items and can be safely removed.</p>
                            }
                        </div>
                        <div class="modal-footer border-top">
                            <button type="button" class="jt-btn jt-btn-outline jt-btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <form asp-action="DeleteMedia" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="fileName" value="@item.FileName" />
                                <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                                    Confirm Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>
}

<div class="modal fade" id="uploadMediaModal" tabindex="-1" aria-labelledby="uploadMediaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title jt-serif" id="uploadMediaModalLabel">Upload Image Asset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UploadMedia" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Culinary Image File <span class="text-danger">*</span></label>
                        <input type="file" name="File" class="form-control" accept=".jpg,.jpeg,.png,.webp" required />
                        <div class="form-text small text-muted">
                            Supported file formats: <strong>JPEG (.jpg, .jpeg)</strong>, <strong>PNG (.png)</strong>, <strong>WebP (.webp)</strong>.
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 small text-muted">
                        <div class="fw-bold text-dark mb-1">Security &amp; Storage Policies:</div>
                        <ul class="mb-0 ps-3">
                            <li>Maximum file size: <strong>5 MB</strong>.</li>
                            <li>Image files must be complete, decodable, and larger than header-only fixtures.</li>
                            <li>Strict MIME and file header signature inspection enforced.</li>
                            <li>Path traversal and unsafe filenames are automatically rejected.</li>
                            <li>A cryptographically unique name is generated to avoid overwrites.</li>
                            <li>Files are stored under <code>/uploads/editorial/</code>.</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="jt-btn jt-btn-outline jt-btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="jt-btn jt-btn-primary jt-btn-sm">
                        Upload to Library
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyMediaUrl(url, btn) {
            navigator.clipboard.writeText(url).then(function() {
                var originalText = btn.innerText;
                btn.innerText = 'Copied';
                btn.classList.add('is-confirmed');
                setTimeout(function() {
                    btn.innerText = originalText;
                    btn.classList.remove('is-confirmed');
                }, 2000);
            }).catch(function() {
                prompt("Copy URL manually:", url);
            });
        }
    </script>
}
