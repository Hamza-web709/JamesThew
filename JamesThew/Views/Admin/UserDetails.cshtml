@model JamesThew.ViewModels.AdminUserDetailsViewModel
@using JamesThew.Authorization
@{
    ViewData["Title"] = $"{Model.DisplayName} - User Details - JamesThew Admin";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <strong>&#10004; Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <strong>&#9888; Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-2">
    <div>
        <a href="@Model.ReturnUrl" class="text-decoration-none text-muted small">&larr; Back to Users</a>
        <div class="d-flex align-items-center gap-3 mt-2">
            <div class="jt-admin-user-avatar-lg" aria-hidden="true">
                @(!string.IsNullOrWhiteSpace(Model.DisplayName) ? Model.DisplayName[0].ToString().ToUpperInvariant() : "U")
            </div>
            <div>
                <h1 class="h2 jt-serif mb-1 text-dark">@Model.DisplayName</h1>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted small">@Model.Email</span>
                    <span class="text-muted small">&bull;</span>
                    @if (Model.Role == AppRoles.Admin)
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Administrator</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Member</span>
                    }
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">&#10003; Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">&#9679; Inactive</span>
                    }
                    @if (Model.EmailConfirmed)
                    {
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">&#10003; Verified</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">&#9888; Unverified</span>
                    }
                    @if (Model.IsTemporarilyLocked)
                    {
                        <span class="badge bg-danger">Temporarily Locked</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Available</span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="EditUser" asp-route-id="@Model.Id" class="jt-btn jt-btn-primary jt-btn-sm">Edit Profile</a>
        <a href="@Model.ReturnUrl" class="jt-btn jt-btn-outline jt-btn-sm">&larr; Back to Users</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- SECTION A: Account Details -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-bottom py-3">
                <h2 class="h5 jt-serif mb-0 text-dark">Section A &mdash; Account Details</h2>
                <div class="text-muted small">Identity credentials and security standing</div>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small text-uppercase">User ID</dt>
                    <dd class="col-sm-8 font-monospace small text-break">@Model.Id</dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Display Name</dt>
                    <dd class="col-sm-8 fw-semibold text-dark">@Model.DisplayName</dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Email</dt>
                    <dd class="col-sm-8 text-break">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Assigned Role</dt>
                    <dd class="col-sm-8">
                        @if (Model.Role == AppRoles.Admin)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Administrator</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Member</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Account Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">&#10003; Active</span>
                            <span class="small text-muted ms-2">Account is enabled</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">&#9679; Inactive</span>
                            <span class="small text-danger ms-2">Account is administratively disabled</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Email Verification</dt>
                    <dd class="col-sm-8">
                        @if (Model.EmailConfirmed)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">&#10003; Confirmed</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">&#9888; Unverified</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Security Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsTemporarilyLocked)
                        {
                            <div class="mb-1">
                                <span class="badge bg-danger">Temporarily Locked</span>
                            </div>
                            <div class="small text-danger">
                                <strong>Temporary Identity Lockout:</strong> Until @(Model.LockoutEnd.HasValue ? Model.LockoutEnd.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") : "unknown")
                            </div>
                            @if (Model.AccessFailedCount > 0)
                            {
                                <div class="small text-muted mt-1">Failed access attempts: @Model.AccessFailedCount</div>
                            }
                        }
                        else
                        {
                            <div>
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Available</span>
                            </div>
                            <div class="small text-muted mt-1">Account authentication access is available.</div>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- SECTION B: Membership Details -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-bottom py-3">
                <h2 class="h5 jt-serif mb-0 text-dark">Section B &mdash; Membership &amp; Subscriptions</h2>
                <div class="text-muted small">Subscription status, tier, and renewal lifecycle</div>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small text-uppercase">Current Plan</dt>
                    <dd class="col-sm-8 fw-semibold text-dark">@Model.CurrentPlan</dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Membership Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsMembershipActive)
                        {
                            <span class="badge bg-success">@Model.MembershipLabel</span>
                        }
                        else if (Model.MembershipLabel.Equals("Expired", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-warning text-dark">Expired</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted border">Free</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Expiration Date</dt>
                    <dd class="col-sm-8">
                        @(Model.MembershipExpiry.HasValue ? Model.MembershipExpiry.Value.ToString("yyyy-MM-dd HH:mm 'UTC'") : "No active expiration")
                    </dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Subscription History</dt>
                    <dd class="col-sm-8">
                        <span class="fw-semibold">@Model.SubscriptionHistoryCount</span> request(s) recorded
                    </dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Latest Request</dt>
                    <dd class="col-sm-8">
                        @(!string.IsNullOrWhiteSpace(Model.LatestSubscriptionStatus) ? Model.LatestSubscriptionStatus : "None")
                    </dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Last Approved</dt>
                    <dd class="col-sm-8">
                        @(Model.LastApprovedSubscriptionDate.HasValue ? Model.LastApprovedSubscriptionDate.Value.ToString("yyyy-MM-dd") : "None")
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- SECTION C: Activity Summary -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-transparent border-bottom py-3">
        <h2 class="h5 jt-serif mb-0 text-dark">Section C &mdash; Activity Summary</h2>
        <div class="text-muted small">Member engagement, community contributions, and platform participation</div>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 text-center border">
                    <div class="small text-muted text-uppercase fw-semibold">Recipe Contributions</div>
                    <div class="h3 jt-serif mb-0 text-dark mt-1">@Model.RecipeContributionCount</div>
                    <div class="text-muted small mt-1">Recipes submitted</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 text-center border">
                    <div class="small text-muted text-uppercase fw-semibold">Tip Contributions</div>
                    <div class="h3 jt-serif mb-0 text-dark mt-1">@Model.TipContributionCount</div>
                    <div class="text-muted small mt-1">Tips submitted</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 text-center border">
                    <div class="small text-muted text-uppercase fw-semibold">Contest Entries</div>
                    <div class="h3 jt-serif mb-0 text-dark mt-1">@Model.ContestEntryCount</div>
                    <div class="text-muted small mt-1">
                        @if (Model.WinningContestEntryCount > 0)
                        {
                            <span class="text-success fw-semibold">&#9733; @Model.WinningContestEntryCount winning</span>
                        }
                        else
                        {
                            <span>0 winning entries</span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 bg-light rounded-3 text-center border">
                    <div class="small text-muted text-uppercase fw-semibold">Feedback Submissions</div>
                    <div class="h3 jt-serif mb-0 text-dark mt-1">@Model.FeedbackCount</div>
                    <div class="text-muted small mt-1">Feedback messages sent</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECTION D: Role Management & Governance -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-transparent border-bottom py-3">
        <h2 class="h5 jt-serif mb-0 text-dark">Section D &mdash; Role Management & Governance</h2>
        <div class="text-muted small">Administrative actions and security role governance</div>
    </div>
    <div class="card-body p-4">
        <!-- Profile Editing Action -->
        <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom gap-2">
            <div>
                <div class="fw-semibold text-dark">Account Profile Details</div>
                <div class="text-muted small">Update Display Name and email address credentials.</div>
            </div>
            <a asp-action="EditUser" asp-route-id="@Model.Id" class="jt-btn jt-btn-outline jt-btn-sm">Edit Profile</a>
        </div>

        <!-- Role Management Subsection -->
        <div>
            <div class="fw-semibold text-dark mb-1">Security Role Assignment</div>
            <div class="text-muted small mb-3">Manage administrative and member privilege boundaries. Changing a role invalidates all active sessions.</div>

            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <span class="text-muted small">Current Role:</span>
                @if (Model.Role == AppRoles.Admin)
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1">Administrator</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-3 py-1">Member</span>
                }
            </div>

            @if (Model.IsDemoAdmin)
            {
                <div class="alert alert-warning border d-flex align-items-center gap-2 mb-0" role="alert">
                    <span>&#9888;</span>
                    <div class="small">
                        <strong>Demo Administrator Account:</strong> The seeded demo administrator must retain the Administrator role. Role transitions are locked for this account.
                    </div>
                </div>
            }
            else if (Model.IsCurrentAdmin)
            {
                <div class="alert alert-info border d-flex align-items-center gap-2 mb-0" role="alert">
                    <span>&#9432;</span>
                    <div class="small">
                        <strong>Current Active Session:</strong> You are currently signed in as this administrator. Self-demotion is disabled to prevent accidental administrative lockout.
                    </div>
                </div>
            }
            else if (Model.IsOnlyAdmin)
            {
                <div class="alert alert-warning border d-flex align-items-center gap-2 mb-0" role="alert">
                    <span>&#9888;</span>
                    <div class="small">
                        <strong>Sole Administrator:</strong> This account is the only Administrator in the system. Demoting this account is blocked to ensure system governance continuity.
                    </div>
                </div>
            }
            else
            {
                <form asp-action="ChangeRole" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-center" onsubmit="return confirm('Are you sure you want to change this user\'s role? This will alter their system privileges and invalidate all active sessions.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                    <div class="col-auto">
                        <label for="TargetRole" class="visually-hidden">Target Role</label>
                        <select id="TargetRole" name="TargetRole" class="form-select form-select-sm">
                            <option value="@AppRoles.Member" selected="@(Model.Role == AppRoles.Member)">Member</option>
                            <option value="@AppRoles.Admin" selected="@(Model.Role == AppRoles.Admin)">Administrator</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="jt-btn jt-btn-primary jt-btn-sm">Update Role</button>
                    </div>
                    <div class="col-12 mt-2">
                        <span class="form-text text-muted small">Select the new privilege tier and submit. Browser confirmation is required.</span>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<!-- SECTION E: Account Access & Status Governance -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-transparent border-bottom py-3">
        <h2 class="h5 jt-serif mb-0 text-dark">Section E &mdash; Account Access &amp; Status Governance</h2>
        <div class="text-muted small">Administrative account activation, deactivation, and authentication availability control</div>
    </div>
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div>
                <span class="text-muted small me-2">Account Status:</span>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-1">&#10003; Active</span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle px-3 py-1">&#10007; Inactive</span>
                }
            </div>
            <div class="small text-muted">
                Deactivation prevents sign-in and account recovery until an administrator reactivates the account.
            </div>
        </div>

        @if (Model.IsActive)
        {
            @if (Model.IsCurrentAdmin)
            {
                <div class="alert alert-info border d-flex align-items-center gap-2 mb-3" role="alert">
                    <span>&#9432;</span>
                    <div class="small">
                        <strong>Current Active Session:</strong> You cannot deactivate your own account. Administrative governance prevents self-deactivation.
                    </div>
                </div>
            }
            @if (Model.IsDemoAdmin)
            {
                <div class="alert alert-warning border d-flex align-items-center gap-2 mb-3" role="alert">
                    <span>&#9888;</span>
                    <div class="small">
                        <strong>Demo Administrator Account:</strong> The demo administrator account cannot be deactivated.
                    </div>
                </div>
            }
            @if (!Model.IsCurrentAdmin && !Model.IsDemoAdmin && Model.IsLastActiveAdmin)
            {
                <div class="alert alert-warning border d-flex align-items-center gap-2 mb-3" role="alert">
                    <span>&#9888;</span>
                    <div class="small">
                        <strong>Last Active Administrator:</strong> The system must retain at least one active Administrator. Deactivation is locked for this account.
                    </div>
                </div>
            }
            @if (Model.CanDeactivate)
            {
                <div class="p-3 bg-light rounded-3 border">
                    <p class="small text-muted mb-3">
                        Deactivating this account will immediately revoke access, invalidate pending one-time passcodes, and rotate authentication security tokens.
                    </p>
                    <form asp-action="DeactivateUser" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Deactivate this account? The user will be unable to sign in until an administrator reactivates it.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@(Url.Action("UserDetails", "Admin", new { id = Model.Id, returnUrl = Model.ReturnUrl }))" />
                        <button type="submit" class="jt-btn jt-btn-outline-danger jt-btn-sm" id="btn-deactivate-user">
                            Deactivate Account
                        </button>
                    </form>
                </div>
            }
        }
        else
        {
            <div class="p-3 bg-light rounded-3 border">
                <p class="small text-muted mb-3">
                    Reactivating this account will restore authentication access. The user will be able to sign in or initiate account recovery using fresh verification codes.
                </p>
                <form asp-action="ActivateUser" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Reactivate this account?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@(Url.Action("UserDetails", "Admin", new { id = Model.Id, returnUrl = Model.ReturnUrl }))" />
                    <button type="submit" class="jt-btn jt-btn-outline-success jt-btn-sm" id="btn-activate-user">
                        Activate Account
                    </button>
                </form>
            </div>
        }
    </div>
</div>

<div class="mb-4">
    <a href="@Model.ReturnUrl" class="jt-btn jt-btn-outline">&larr; Back to Users</a>
</div>
