@model JamesThew.ViewModels.AdminContestEntriesViewModel
@using JamesThew.Models
@{
    ViewData["Title"] = $"Submissions: {Model.ContestTitle} - Admin Portal";
}

<div class="mb-5 max-w-1000 mx-auto">
    <!-- Breadcrumbs -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Contests" class="text-decoration-none text-muted small">
            &larr; Back to Contest Management
        </a>
        <a href="/contests/@Model.ContestSlug" target="_blank" class="text-decoration-none text-muted small">
            View Public Contest Page &#8599;
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            &#10004; @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Card -->
    <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    @if (Model.ContestType == ContestType.Recipe)
                    {
                        <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1">
                            &#127859; Recipe Competition
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border rounded-pill px-3 py-1">
                            &#128161; Cooking Tip Competition
                        </span>
                    }

                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                        Status: @Model.ContestStatus
                    </span>

                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">
                        &#128065; Read-Only Intake Review &amp; Judging
                    </span>

                    @if (Model.TimelinePhase == ContestTimelinePhase.Open)
                    {
                        <span class="badge bg-success rounded-pill px-3 py-1">
                            &#9889; Open for Entries
                        </span>
                    }
                    else if (Model.TimelinePhase == ContestTimelinePhase.Upcoming)
                    {
                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3 py-1">
                            Upcoming
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary rounded-pill px-3 py-1">
                            &#128274; Concluded
                        </span>
                    }
                </div>

                <h1 class="h2 jt-serif mb-1">@Model.ContestTitle</h1>
                <p class="text-muted small font-monospace mb-0">
                    Window: @Model.OpensAtUtc.ToString("MMM d, yyyy HH:mm") UTC &rarr; @Model.ClosesAtUtc.ToString("MMM d, yyyy HH:mm") UTC
                </p>
            </div>

            <div class="text-md-end">
                <span class="display-6 fw-bold text-primary">@Model.TotalEntries</span>
                <span class="d-block small text-muted">Total Submissions</span>
            </div>
        </div>
    </div>

    <!-- Phase 5C Winner Status Panel -->
    @if (Model.HasSelectedWinner)
    {
        <div class="card border-warning border-2 shadow-sm rounded-4 mb-4 bg-warning-subtle p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <span class="badge bg-warning text-dark border rounded-pill px-3 py-1 mb-2">
                        &#127942; Competition Winner
                    </span>
                    <h2 class="h4 jt-serif mb-1 text-dark">
                        @Model.WinningEntryTitle
                    </h2>
                    <p class="small text-muted mb-1">
                        Submitted by: <strong>@Model.WinningAuthorDisplayName</strong> &bull; Selected: @(Model.WinnerSelectedAtUtc?.ToString("MMM d, yyyy HH:mm") ?? "—") UTC
                    </p>
                    @if (Model.HasAnnouncedWinner)
                    {
                        <div class="badge bg-success text-white px-3 py-1 rounded-pill small">
                            &#10004; Publicly Announced (@Model.WinnerAnnouncedAtUtc?.ToString("MMM d, yyyy HH:mm") UTC)
                        </div>
                    }
                    else
                    {
                        <div class="badge bg-secondary text-white px-3 py-1 rounded-pill small">
                            &#128274; Unannounced (Visible only to Admin jury)
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @if (!Model.HasAnnouncedWinner)
                    {
                        <form asp-action="AnnounceContestWinner" asp-route-id="@Model.ContestId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm px-3 py-2 fw-semibold" onclick="return confirm('Publish this winner to the public announcements board and contest page?');">
                                &#128227; Announce Winner Publicly
                            </button>
                        </form>
                    }

                    <button type="button" class="btn btn-outline-danger btn-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#revokeWinnerModal">
                        &#10008; Revoke Winner
                    </button>
                </div>
            </div>
        </div>

        <!-- Revoke Winner Modal -->
        <div class="modal fade" id="revokeWinnerModal" tabindex="-1" aria-labelledby="revokeWinnerModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="RevokeContestWinner" asp-route-id="@Model.ContestId" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title h6" id="revokeWinnerModalLabel">Revoke Competition Winner</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="small text-muted">
                                Revoking the winner will return the winning entry to <strong>Under Review</strong> and withdraw any public announcements for this contest.
                            </p>
                            <div class="mb-3">
                                <label for="revokeReason" class="form-label small fw-semibold">Reason for Revocation (optional):</label>
                                <textarea name="reason" id="revokeReason" class="form-control" rows="3" placeholder="e.g., Eligibility disqualification or judging reconsideration."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger btn-sm">Confirm Revocation</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert @(Model.CanSelectWinner ? "alert-primary" : "alert-light border") shadow-sm rounded-4 mb-4 p-3" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4">&#9878;</span>
                <div>
                    @if (Model.CanSelectWinner)
                    {
                        <strong class="d-block text-primary">Submissions Concluded &mdash; Ready for Final Winner Selection</strong>
                        <span class="small text-muted">
                            Review submitted entries below. Expand an entry to evaluate its formulation, record qualitative review notes, and select the winning dish.
                        </span>
                    }
                    else
                    {
                        <strong class="d-block text-muted">Competition Active &mdash; Submissions Open</strong>
                        <span class="small text-muted">
                            Members are actively submitting entries. Final winner selection unlocks once the submission deadline passes or when the competition is closed.
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    @if (Model.TotalEntries == 0)
    {
        <div class="p-5 text-center bg-white rounded-4 border shadow-sm text-muted">
            <div class="fs-1 mb-2">&#128221;</div>
            <h2 class="h5 jt-serif">No Submissions Yet</h2>
            <p class="small mb-0">No registered members have submitted recipes or tips for this competition so far.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0 jt-serif">Submitted Contest Entries (@Model.TotalEntries)</h2>
                <span class="small text-muted font-monospace">Qualitative Judging &amp; Selection</span>
            </div>

            <div class="accordion accordion-flush" id="entriesAccordion">
                @for (int i = 0; i < Model.Entries.Count; i++)
                {
                    var entry = Model.Entries[i];
                    var headingId = $"heading{entry.EntryId}";
                    var collapseId = $"collapse{entry.EntryId}";

                    <div class="accordion-item border-bottom">
                        <h3 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed py-3 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                <div class="d-flex flex-wrap align-items-center justify-content-between w-100 me-3 gap-2">
                                    <div>
                                        <span class="badge bg-secondary-subtle text-secondary me-2">#@entry.EntryId</span>
                                        <strong class="text-dark">@entry.Title</strong>
                                        <span class="text-muted small ms-2">&mdash; by @entry.AuthorDisplayName (@entry.AuthorEmail)</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (entry.IsSelectedWinner)
                                        {
                                            <span class="badge bg-warning text-dark border rounded-pill px-2 py-1 small">
                                                &#127942; Winner
                                            </span>
                                        }
                                        else if (entry.Status == ContestEntryStatus.UnderReview)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border rounded-pill px-2 py-1 small">
                                                &#128065; Under Review
                                            </span>
                                        }
                                        else if (entry.Status == ContestEntryStatus.Disqualified)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border rounded-pill px-2 py-1 small">
                                                &#10008; Disqualified
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                                                Submitted
                                            </span>
                                        }

                                        <span class="small text-muted font-monospace">
                                            @entry.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                                        </span>
                                    </div>
                                </div>
                            </button>
                        </h3>

                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#entriesAccordion">
                            <div class="accordion-body bg-light p-4">
                                <!-- Teaser Summary -->
                                <div class="p-3 bg-white rounded-3 border mb-3">
                                    <h4 class="small text-muted font-monospace mb-1">Summary Teaser</h4>
                                    <p class="mb-0">@entry.Summary</p>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(entry.ImageUrl))
                                {
                                    <div class="mb-3">
                                        <h4 class="small text-muted font-monospace mb-1">Attached Photo URL</h4>
                                        <a href="@entry.ImageUrl" target="_blank" class="small text-truncate d-block">@entry.ImageUrl</a>
                                    </div>
                                }

                                @if (Model.ContestType == ContestType.Recipe)
                                {
                                    <div class="row g-3 mb-3">
                                        <div class="col-sm-4">
                                            <div class="p-2 bg-white rounded border small text-center">
                                                <span class="text-muted d-block">Servings</span>
                                                <strong>@(entry.Servings?.ToString() ?? "—")</strong>
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="p-2 bg-white rounded border small text-center">
                                                <span class="text-muted d-block">Prep Minutes</span>
                                                <strong>@(entry.PrepMinutes?.ToString() ?? "—")</strong>
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="p-2 bg-white rounded border small text-center">
                                                <span class="text-muted d-block">Cook Minutes</span>
                                                <strong>@(entry.CookMinutes?.ToString() ?? "—")</strong>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <div class="p-3 bg-white rounded-3 border h-100">
                                                <h4 class="h6 jt-serif mb-2 text-primary">&#129367; Ingredients (@entry.Ingredients.Count)</h4>
                                                <ul class="list-unstyled mb-0 small">
                                                    @foreach (var ing in entry.Ingredients)
                                                    {
                                                        <li class="py-1 border-bottom">&#8226; @ing</li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-3 bg-white rounded-3 border h-100">
                                                <h4 class="h6 jt-serif mb-2 text-primary">&#127859; Preparation Steps (@entry.Steps.Count)</h4>
                                                <ol class="mb-0 small ps-3">
                                                    @foreach (var step in entry.Steps)
                                                    {
                                                        <li class="py-1">@step</li>
                                                    }
                                                </ol>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-3 bg-white rounded-3 border mb-3">
                                        <h4 class="h6 jt-serif mb-2 text-warning-emphasis">&#128161; Technique &amp; Wisdom Body</h4>
                                        <div class="small text-body lh-base" style="white-space: pre-line;">
                                            @entry.TipBody
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.Notes))
                                {
                                    <div class="p-3 bg-white rounded-3 border mb-3">
                                        <h4 class="small text-muted font-monospace mb-1">&#128221; Author Remarks</h4>
                                        <p class="small text-muted mb-0">@entry.Notes</p>
                                    </div>
                                }

                                <!-- Admin Judging & Review Section -->
                                <div class="p-3 bg-white rounded-3 border mb-3">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 pb-2 border-bottom">
                                        <h4 class="h6 jt-serif mb-0 text-dark">&#9878; Admin Qualitative Review</h4>
                                        @if (entry.ReviewedAtUtc.HasValue)
                                        {
                                            <span class="small text-muted font-monospace">
                                                Last Reviewed: @entry.ReviewedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC
                                                @(entry.ReviewedByDisplayName != null ? $"by {entry.ReviewedByDisplayName}" : "")
                                            </span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(entry.AdminReviewNotes))
                                    {
                                        <div class="alert alert-light border small mb-3">
                                            <strong>Private Notes:</strong>
                                            <div style="white-space: pre-line;">@entry.AdminReviewNotes</div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(entry.DisqualificationReason))
                                    {
                                        <div class="alert alert-danger small mb-3">
                                            <strong>Disqualification Reason:</strong> @entry.DisqualificationReason
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(entry.RevocationReason))
                                    {
                                        <div class="alert alert-warning small mb-3">
                                            <strong>Winner Revocation Audit:</strong> @entry.RevocationReason
                                            @if (entry.RevokedAtUtc.HasValue)
                                            {
                                                <span class="text-muted ms-2">(@entry.RevokedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC)</span>
                                            }
                                        </div>
                                    }

                                    <form asp-action="ReviewContestEntry" asp-route-id="@Model.ContestId" asp-route-entryId="@entry.EntryId" method="post" class="row g-2 align-items-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ContestId" value="@Model.ContestId" />
                                        <input type="hidden" name="EntryId" value="@entry.EntryId" />

                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Status Decision</label>
                                            <select name="Status" class="form-select form-select-sm">
                                                <option value="@((int)ContestEntryStatus.Submitted)" selected="@(entry.Status == ContestEntryStatus.Submitted ? "selected" : null)">Submitted</option>
                                                <option value="@((int)ContestEntryStatus.UnderReview)" selected="@(entry.Status == ContestEntryStatus.UnderReview ? "selected" : null)">Under Review</option>
                                                <option value="@((int)ContestEntryStatus.Disqualified)" selected="@(entry.Status == ContestEntryStatus.Disqualified ? "selected" : null)">Disqualified</option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Private Notes</label>
                                            <textarea name="AdminReviewNotes" rows="2" class="form-control form-control-sm" placeholder="Notes for jury panel...">@entry.AdminReviewNotes</textarea>
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Disqualification Reason</label>
                                            <textarea name="DisqualificationReason" rows="2" class="form-control form-control-sm" placeholder="Reason if disqualified...">@entry.DisqualificationReason</textarea>
                                        </div>

                                        <div class="col-md-2">
                                            <button type="submit" class="btn btn-secondary btn-sm w-100">
                                                Save Review
                                            </button>
                                        </div>
                                    </form>

                                    <!-- Winner Selection Action -->
                                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                        <div>
                                            @if (entry.IsSelectedWinner)
                                            {
                                                <span class="badge bg-warning text-dark border px-3 py-2 fs-6">
                                                    &#127942; Designated Competition Winner
                                                </span>
                                            }
                                        </div>

                                        <div>
                                            @if (!entry.IsSelectedWinner)
                                            {
                                                @if (Model.CanSelectWinner && entry.Status != ContestEntryStatus.Disqualified)
                                                {
                                                    <form asp-action="SelectContestWinner" asp-route-id="@Model.ContestId" asp-route-entryId="@entry.EntryId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-primary btn-sm px-3 py-2 fw-semibold" onclick="return confirm('Designate \'@entry.Title\' as the official winner of this competition?');">
                                                            &#127942; Select as Winner
                                                        </button>
                                                    </form>
                                                }
                                                else if (!Model.CanSelectWinner)
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Submission window must conclude before selecting winner">
                                                        &#128274; Selection Locked (Window Active)
                                                    </button>
                                                }
                                                else if (entry.Status == ContestEntryStatus.Disqualified)
                                                {
                                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled title="Disqualified entry cannot win">
                                                        &#10008; Disqualified from Winning
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
