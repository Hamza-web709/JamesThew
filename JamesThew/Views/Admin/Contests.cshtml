@model JamesThew.ViewModels.AdminContestListViewModel
@using JamesThew.Models
@{
    ViewData["Title"] = "Contests Management - JamesThew Admin";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Admin Dashboard</a>
        <h1 class="h2 jt-serif mt-2 mb-1">Contests Management</h1>
        <p class="text-muted small mb-0">Create, publish, edit, close, and manage seasonal recipe and cooking tip competitions.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <a asp-action="Media" class="jt-btn jt-btn-outline jt-btn-sm">
            &#128444; Media Library
        </a>
        <a asp-action="NewContest" class="jt-btn jt-btn-primary jt-btn-sm">
            &#127942; + New Contest
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <strong>&#10004; Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <strong>&#9888; Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Statistics -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">Total Contests</div>
            <div class="h3 jt-serif mb-0 text-dark">@Model.TotalCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">&#9889; Active Open Now</div>
            <div class="h3 jt-serif mb-0 text-success">@Model.OpenNowCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">&#128337; Upcoming</div>
            <div class="h3 jt-serif mb-0 text-primary">@Model.UpcomingCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">Drafts / Closed</div>
            <div class="h3 jt-serif mb-0 text-warning-emphasis">@Model.DraftsCount <span class="fs-6 text-muted font-monospace">/ @Model.ClosedCount</span></div>
        </div>
    </div>
</div>

<!-- Filters and Controls -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <!-- Status Tabs -->
        <ul class="nav nav-pills gap-1">
            <li class="nav-item">
                <a class="nav-link px-3 py-1 small rounded-pill @(Model.StatusFilter == null ? "active" : "")"
                   asp-action="Contests" asp-route-status="" asp-route-type="@Model.TypeFilter">All</a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-3 py-1 small rounded-pill @(Model.StatusFilter == ContestStatus.Published ? "active" : "")"
                   asp-action="Contests" asp-route-status="@ContestStatus.Published" asp-route-type="@Model.TypeFilter">Published</a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-3 py-1 small rounded-pill @(Model.StatusFilter == ContestStatus.Draft ? "active" : "")"
                   asp-action="Contests" asp-route-status="@ContestStatus.Draft" asp-route-type="@Model.TypeFilter">Drafts</a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-3 py-1 small rounded-pill @(Model.StatusFilter == ContestStatus.Closed ? "active" : "")"
                   asp-action="Contests" asp-route-status="@ContestStatus.Closed" asp-route-type="@Model.TypeFilter">Closed</a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-3 py-1 small rounded-pill @(Model.StatusFilter == ContestStatus.Archived ? "active" : "")"
                   asp-action="Contests" asp-route-status="@ContestStatus.Archived" asp-route-type="@Model.TypeFilter">Archived</a>
            </li>
        </ul>

        <!-- Type Filter -->
        <div class="d-flex align-items-center gap-2">
            <span class="small text-muted">Type:</span>
            <div class="btn-group btn-group-sm" role="group">
                <a asp-action="Contests" asp-route-status="@Model.StatusFilter" asp-route-type=""
                   class="btn @(Model.TypeFilter == null ? "btn-secondary" : "btn-outline-secondary")">All</a>
                <a asp-action="Contests" asp-route-status="@Model.StatusFilter" asp-route-type="@ContestType.Recipe"
                   class="btn @(Model.TypeFilter == ContestType.Recipe ? "btn-secondary" : "btn-outline-secondary")">&#127859; Recipes</a>
                <a asp-action="Contests" asp-route-status="@Model.StatusFilter" asp-route-type="@ContestType.Tip"
                   class="btn @(Model.TypeFilter == ContestType.Tip ? "btn-secondary" : "btn-outline-secondary")">&#128161; Tips</a>
            </div>
        </div>
    </div>
</div>

<!-- Contests Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    @if (Model.Contests.Count == 0)
    {
        <div class="p-5 text-center text-muted">
            <div class="fs-1 mb-2">&#127942;</div>
            <h3 class="h5 jt-serif">No Contests Found</h3>
            <p class="small mb-3">No competitions match the selected status and category filters.</p>
            <a asp-action="NewContest" class="jt-btn jt-btn-primary jt-btn-sm">+ Create Your First Contest</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th style="width: 60px;">Cover</th>
                        <th>Contest Details</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Entries</th>
                        <th>Timeline Window</th>
                        <th class="text-end" style="width: 260px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contest in Model.Contests)
                    {
                        <tr class="@(contest.IsDeleted ? "table-light text-muted" : "")">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(contest.ImageUrl))
                                {
                                    <img src="@contest.ImageUrl" alt="@contest.Title" class="rounded object-fit-cover" style="width: 48px; height: 48px;" />
                                }
                                else
                                {
                                    <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted" style="width: 48px; height: 48px;">
                                        &#127942;
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@contest.Title</div>
                                <div class="small font-monospace text-muted">/contests/@contest.Slug</div>
                                @if (!string.IsNullOrWhiteSpace(contest.PrizeDescription))
                                {
                                    <div class="small text-muted">&#127941; @contest.PrizeDescription</div>
                                }
                            </td>
                            <td>
                                @if (contest.Type == ContestType.Recipe)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1">
                                        &#127859; Recipe
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1">
                                        &#128161; Tip
                                    </span>
                                }
                            </td>
                            <td>
                                @if (contest.IsDeleted || contest.Status == ContestStatus.Archived)
                                {
                                    <span class="badge bg-secondary rounded-pill px-2 py-1">&#128465; Archived</span>
                                }
                                else if (contest.Status == ContestStatus.Published)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                        &#10004; Published
                                    </span>
                                }
                                else if (contest.Status == ContestStatus.Draft)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                                        &#9998; Draft
                                    </span>
                                }
                                else if (contest.Status == ContestStatus.Closed)
                                {
                                    <span class="badge bg-dark-subtle text-dark border border-dark-subtle rounded-pill px-2 py-1">
                                        &#128274; Closed
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="ContestEntries" asp-route-id="@contest.Id" class="badge @(contest.EntriesCount > 0 ? "bg-primary text-white" : "bg-light text-muted border") text-decoration-none rounded-pill px-3 py-1" title="View Submitted Entries">
                                    &#128221; @contest.EntriesCount
                                </a>
                            </td>
                            <td>
                                <div class="small">
                                    @if (contest.TimelinePhase == ContestTimelinePhase.Open && contest.Status == ContestStatus.Published)
                                    {
                                        <span class="badge bg-success rounded-pill px-2 py-0 me-1">Active Open</span>
                                    }
                                    else if (contest.TimelinePhase == ContestTimelinePhase.Upcoming && contest.Status == ContestStatus.Published)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-2 py-0 me-1">Upcoming</span>
                                    }
                                    else if (contest.Status == ContestStatus.Published)
                                    {
                                        <span class="badge bg-light text-muted border rounded-pill px-2 py-0 me-1">Ended</span>
                                    }
                                </div>
                                <div class="small text-muted font-monospace mt-1">
                                    @contest.OpensAtUtc.ToString("yyyy-MM-dd HH:mm") UTC &rarr;
                                    <br />
                                    @contest.ClosesAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1 flex-wrap">
                                    @if (!contest.IsDeleted)
                                    {
                                        <a asp-action="ContestEntries" asp-route-id="@contest.Id" class="btn btn-outline-info btn-sm" title="View Entries">
                                            Entries (@contest.EntriesCount)
                                        </a>
                                        <a asp-action="EditContest" asp-route-id="@contest.Id" class="btn btn-outline-secondary btn-sm" title="Edit Contest">
                                            Edit
                                        </a>

                                        @if (contest.Status == ContestStatus.Draft)
                                        {
                                            <form method="post" asp-action="PublishContest" asp-route-id="@contest.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success btn-sm" title="Publish to public catalog">
                                                    Publish
                                                </button>
                                            </form>
                                        }
                                        else if (contest.Status == ContestStatus.Published)
                                        {
                                            <a href="/contests/@contest.Slug" target="_blank" class="btn btn-outline-primary btn-sm" title="View Public Page">
                                                View
                                            </a>
                                            <form method="post" asp-action="UnpublishContest" asp-route-id="@contest.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning btn-sm" title="Revert to Draft (hide from public)">
                                                    Draft
                                                </button>
                                            </form>
                                            <form method="post" asp-action="CloseContest" asp-route-id="@contest.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-dark btn-sm" title="Close contest early">
                                                    Close
                                                </button>
                                            </form>
                                        }
                                        else if (contest.Status == ContestStatus.Closed)
                                        {
                                            <form method="post" asp-action="PublishContest" asp-route-id="@contest.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success btn-sm" title="Re-open / publish">
                                                    Reopen
                                                </button>
                                            </form>
                                        }

                                        <form method="post" asp-action="ArchiveContest" asp-route-id="@contest.Id" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to archive this contest? It will be removed from active public view.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Archive / Remove">
                                                Archive
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="RestoreContest" asp-route-id="@contest.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Restore from archive">
                                                Restore
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
