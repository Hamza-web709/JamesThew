@{
    ViewData["Title"] = "Admin Dashboard";
    var pendingSubscriptions = (int)(ViewBag.PendingSubscriptionsCount ?? 0);
    var pendingFeedback = (int)(ViewBag.PendingFeedbackCount ?? 0);
    var pendingContributions = (int)(ViewBag.PendingContributionsCount ?? 0);
    var editorialRecipes = (int)(ViewBag.EditorialRecipesCount ?? 0);
    var editorialTips = (int)(ViewBag.EditorialTipsCount ?? 0);
    var mediaItems = (int)(ViewBag.MediaItemsCount ?? 0);
    var mediaSize = (string)(ViewBag.MediaTotalSize ?? "0 B");
    var totalContests = (int)(ViewBag.TotalContestsCount ?? 0);
    var activeOpenContests = (int)(ViewBag.ActiveOpenContestsCount ?? 0);
}

<div class="jt-admin-dashboard">
    <section class="jt-admin-hero" aria-labelledby="admin-dashboard-title">
        <div>
            <span class="jt-admin-eyebrow">Culinary Operations</span>
            <h1 id="admin-dashboard-title">JamesThew Admin Console</h1>
            <p>
                Manage editorial publishing, media assets, subscription review, feedback moderation,
                community content intake, and seasonal contest operations from one focused workspace.
            </p>
        </div>
        <div class="jt-admin-health-strip" aria-label="Current operational counts">
            <div class="jt-admin-health-pill">
                <strong>@(pendingSubscriptions + pendingFeedback + pendingContributions)</strong>
                <span>Pending actions</span>
            </div>
            <div class="jt-admin-health-pill">
                <strong>@(editorialRecipes + editorialTips)</strong>
                <span>Editorial items</span>
            </div>
            <div class="jt-admin-health-pill">
                <strong>@activeOpenContests</strong>
                <span>Active contests</span>
            </div>
        </div>
    </section>

    <section class="jt-admin-card-grid" aria-label="Admin modules">
        <article class="jt-admin-module-card">
            <div>
                <div class="jt-admin-module-top">
                    <span class="jt-admin-module-icon" aria-hidden="true">ED</span>
                    <span class="jt-admin-module-stat">
                        <strong>@editorialRecipes recipes</strong>
                        @editorialTips tips
                    </span>
                </div>
                <h2>Editorial Content</h2>
                <p>Author, edit, publish, or unpublish official James Thew recipes and cooking tips.</p>
            </div>
            <div class="jt-admin-module-actions">
                <a asp-action="NewRecipe" class="jt-btn jt-btn-outline jt-btn-sm">New Recipe</a>
                <a asp-action="NewTip" class="jt-btn jt-btn-outline jt-btn-sm">New Tip</a>
                <a asp-action="Content" class="jt-btn jt-btn-primary jt-btn-sm">Manage Catalog</a>
            </div>
        </article>

        <article class="jt-admin-module-card">
            <div>
                <div class="jt-admin-module-top">
                    <span class="jt-admin-module-icon" aria-hidden="true">MD</span>
                    <span class="jt-admin-module-stat">
                        <strong>@mediaItems files</strong>
                        @mediaSize
                    </span>
                </div>
                <h2>Media Library</h2>
                <p>Upload and manage photography and culinary visuals used across editorial content.</p>
            </div>
            <div class="jt-admin-module-actions">
                <a asp-action="Media" class="jt-btn jt-btn-outline jt-btn-sm">Open Media Library</a>
            </div>
        </article>

        <article class="jt-admin-module-card">
            <div>
                <div class="jt-admin-module-top">
                    <span class="jt-admin-module-icon" aria-hidden="true">MS</span>
                    <span class="jt-admin-module-stat">
                        <strong>@pendingSubscriptions pending</strong>
                        subscriptions
                    </span>
                </div>
                <h2>Membership / Subscriptions</h2>
                <p>Review demo membership plan requests and approve masterclass access when appropriate.</p>
            </div>
            <div class="jt-admin-module-actions">
                <a asp-action="Subscriptions" class="jt-btn jt-btn-outline jt-btn-sm">Review Requests</a>
            </div>
        </article>

        <article class="jt-admin-module-card">
            <div>
                <div class="jt-admin-module-top">
                    <span class="jt-admin-module-icon" aria-hidden="true">FB</span>
                    <span class="jt-admin-module-stat">
                        <strong>@pendingFeedback new</strong>
                        feedback items
                    </span>
                </div>
                <h2>Feedback</h2>
                <p>Read, moderate, and annotate member feedback, culinary questions, and platform suggestions.</p>
            </div>
            <div class="jt-admin-module-actions">
                <a asp-action="Feedback" class="jt-btn jt-btn-outline jt-btn-sm">View Feedback</a>
            </div>
        </article>

        <article class="jt-admin-module-card">
            <div>
                <div class="jt-admin-module-top">
                    <span class="jt-admin-module-icon" aria-hidden="true">IN</span>
                    <span class="jt-admin-module-stat">
                        <strong>@pendingContributions intake</strong>
                        contributions
                    </span>
                </div>
                <h2>Content Intake / Contributions</h2>
                <p>Moderate community recipe and cooking-tip submissions without changing member workflow behavior.</p>
            </div>
            <div class="jt-admin-module-actions">
                <a asp-action="Contributions" class="jt-btn jt-btn-outline jt-btn-sm">View Intake</a>
            </div>
        </article>

        <article class="jt-admin-module-card">
            <div>
                <div class="jt-admin-module-top">
                    <span class="jt-admin-module-icon" aria-hidden="true">CT</span>
                    <span class="jt-admin-module-stat">
                        <strong>@activeOpenContests active</strong>
                        @totalContests total
                    </span>
                </div>
                <h2>Contest Management</h2>
                <p>Create, publish, edit, close, judge, and archive seasonal recipe and cooking-tip competitions.</p>
            </div>
            <div class="jt-admin-module-actions">
                <a asp-action="NewContest" class="jt-btn jt-btn-outline jt-btn-sm">New Contest</a>
                <a asp-action="Contests" class="jt-btn jt-btn-primary jt-btn-sm">Manage Contests</a>
            </div>
        </article>
    </section>
</div>
