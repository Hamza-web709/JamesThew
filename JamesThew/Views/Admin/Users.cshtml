@model JamesThew.ViewModels.AdminUsersIndexViewModel
@using JamesThew.Authorization
@{
    ViewData["Title"] = "User & Member Directory - JamesThew Admin";
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.SearchQuery) ||
                           Model.RoleFilter != "all" ||
                           Model.VerificationFilter != "all" ||
                           Model.MembershipFilter != "all" ||
                           Model.StatusFilter != "all";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Admin Dashboard</a>
        <h1 class="h2 jt-serif mt-2 mb-1">User &amp; Member Directory</h1>
        <p class="text-muted small mb-0">View registered members and administrators, verify contact status, and review membership tiers.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
            @Model.TotalUsersCount Total Accounts
        </span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <strong>&#10004; Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <strong>&#9888; Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">Members</div>
            <div class="h3 jt-serif mb-0 text-dark">@Model.TotalMembersCount</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">Administrators</div>
            <div class="h3 jt-serif mb-0 text-warning-emphasis">@Model.TotalAdminsCount</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">Verified Emails</div>
            <div class="h3 jt-serif mb-0 text-success">@Model.TotalVerifiedCount</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">Active Memberships</div>
            <div class="h3 jt-serif mb-0 text-primary">@Model.TotalActiveMembershipsCount</div>
        </div>
    </div>
</div>

<!-- Search and Filters Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Users" class="row g-2 align-items-center">
            <div class="col-12 col-lg-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">&#128269;</span>
                    <input type="text"
                           name="q"
                           value="@Model.SearchQuery"
                           class="form-control border-start-0"
                           placeholder="Search by name or email..."
                           aria-label="Search users" />
                </div>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <select name="role" class="form-select" aria-label="Filter by role">
                    <option value="all" selected="@(Model.RoleFilter == "all")">All Roles</option>
                    <option value="member" selected="@(Model.RoleFilter == "member")">Members</option>
                    <option value="admin" selected="@(Model.RoleFilter == "admin")">Administrators</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <select name="status" class="form-select" aria-label="Filter by status">
                    <option value="all" selected="@(Model.StatusFilter == "all")">All Status</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <select name="verification" class="form-select" aria-label="Filter by verification">
                    <option value="all" selected="@(Model.VerificationFilter == "all")">All Verification</option>
                    <option value="verified" selected="@(Model.VerificationFilter == "verified")">Verified</option>
                    <option value="unverified" selected="@(Model.VerificationFilter == "unverified")">Unverified</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <select name="membership" class="form-select" aria-label="Filter by membership">
                    <option value="all" selected="@(Model.MembershipFilter == "all")">All Membership</option>
                    <option value="active" selected="@(Model.MembershipFilter == "active")">Active Paid</option>
                    <option value="inactive" selected="@(Model.MembershipFilter == "inactive")">Free / Expired</option>
                </select>
            </div>
            <div class="col-12 col-lg-1 d-flex gap-2">
                <button type="submit" class="jt-btn jt-btn-primary jt-btn-sm flex-fill">Apply</button>
                @if (hasActiveFilters)
                {
                    <a asp-action="Users" class="jt-btn jt-btn-outline jt-btn-sm" title="Clear search and filters">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Users Table Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-0">
        @if (Model.Users.Count == 0)
        {
            <div class="text-center py-5 px-3">
                <div class="fs-1 mb-2 text-muted">&#128101;</div>
                @if (hasActiveFilters)
                {
                    <h2 class="h5 jt-serif text-dark mb-2">No users match the current search or filters.</h2>
                    <p class="text-muted small mb-3">Try adjusting your keywords or clearing the active filters.</p>
                    <a asp-action="Users" class="jt-btn jt-btn-outline jt-btn-sm">Clear All Filters</a>
                }
                else
                {
                    <h2 class="h5 jt-serif text-dark mb-1">No registered users found.</h2>
                    <p class="text-muted small mb-0">Registered member and administrator accounts will appear here.</p>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th scope="col" style="min-width: 180px;">Member</th>
                            <th scope="col" style="min-width: 220px;">Email</th>
                            <th scope="col">Role</th>
                            <th scope="col">Account Status</th>
                            <th scope="col">Verification</th>
                            <th scope="col">Membership</th>
                            <th scope="col">Security</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="jt-admin-user-avatar" aria-hidden="true">
                                            @(!string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName[0].ToString().ToUpperInvariant() : "U")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@user.DisplayName</div>
                                            <div class="text-muted small font-monospace" style="font-size: 0.75rem;">ID: @user.Id.Substring(0, Math.Min(8, user.Id.Length))...</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-break">@user.Email</div>
                                </td>
                                <td>
                                    @if (user.Role == AppRoles.Admin)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Administrator</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Member</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">&#10003; Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">&#9679; Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">&#10003; Verified</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">&#9888; Unverified</span>
                                    }
                                </td>
                                <td>
                                    @if (user.MembershipLabel.StartsWith("Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">@user.MembershipLabel</span>
                                    }
                                    else if (user.MembershipLabel.Equals("Expired", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Free</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsTemporarilyLocked)
                                    {
                                        <span class="badge bg-danger" title="Locked until @user.LockoutEnd">Temporarily Locked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Available</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center justify-content-end gap-1 flex-nowrap">
                                        <a asp-action="UserDetails"
                                           asp-route-id="@user.Id"
                                           asp-route-returnUrl="@(Url.Action("Users", "Admin", new { q = Model.SearchQuery, role = Model.RoleFilter != "all" ? Model.RoleFilter : null, status = Model.StatusFilter != "all" ? Model.StatusFilter : null, verification = Model.VerificationFilter != "all" ? Model.VerificationFilter : null, membership = Model.MembershipFilter != "all" ? Model.MembershipFilter : null, page = Model.Page > 1 ? Model.Page : (int?)null }))"
                                           class="jt-btn jt-btn-outline jt-btn-sm text-nowrap">View Details</a>

                                        @if (user.CanDeactivate)
                                        {
                                            <form asp-action="DeactivateUser" asp-route-id="@user.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Deactivate this account? The user will be unable to sign in until an administrator reactivates it.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@(Url.Action("Users", "Admin", new { q = Model.SearchQuery, role = Model.RoleFilter != "all" ? Model.RoleFilter : null, status = Model.StatusFilter != "all" ? Model.StatusFilter : null, verification = Model.VerificationFilter != "all" ? Model.VerificationFilter : null, membership = Model.MembershipFilter != "all" ? Model.MembershipFilter : null, page = Model.Page > 1 ? Model.Page : (int?)null }))" />
                                                <button type="submit" class="jt-btn jt-btn-outline-danger jt-btn-sm text-nowrap" title="Deactivate account">Deactivate</button>
                                            </form>
                                        }
                                        else if (user.CanActivate)
                                        {
                                            <form asp-action="ActivateUser" asp-route-id="@user.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Reactivate this account?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@(Url.Action("Users", "Admin", new { q = Model.SearchQuery, role = Model.RoleFilter != "all" ? Model.RoleFilter : null, status = Model.StatusFilter != "all" ? Model.StatusFilter : null, verification = Model.VerificationFilter != "all" ? Model.VerificationFilter : null, membership = Model.MembershipFilter != "all" ? Model.MembershipFilter : null, page = Model.Page > 1 ? Model.Page : (int?)null }))" />
                                                <button type="submit" class="jt-btn jt-btn-outline-success jt-btn-sm text-nowrap" title="Activate account">Activate</button>
                                            </form>
                                        }
                                        else if (user.IsCurrentAdmin)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border small" title="Current administrator cannot be deactivated">Self</span>
                                        }
                                        else if (user.IsDemoAdmin)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border small" title="Demo administrator account is protected">Protected</span>
                                        }
                                        else if (user.IsLastActiveAdmin)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border small" title="Last active administrator must be retained">Last Admin</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top gap-2">
                    <div class="small text-muted">
                        Showing @(((Model.Page - 1) * Model.PageSize) + 1)&ndash;@(Math.Min(Model.Page * Model.PageSize, Model.TotalItems)) of @Model.TotalItems users
                    </div>
                    <nav aria-label="User directory pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Users"
                                   asp-route-q="@Model.SearchQuery"
                                   asp-route-role="@Model.RoleFilter"
                                   asp-route-status="@Model.StatusFilter"
                                   asp-route-verification="@Model.VerificationFilter"
                                   asp-route-membership="@Model.MembershipFilter"
                                   asp-route-page="@(Model.Page - 1)"
                                   aria-label="Previous page">
                                    &larr; Prev
                                </a>
                            </li>
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Users"
                                       asp-route-q="@Model.SearchQuery"
                                       asp-route-role="@Model.RoleFilter"
                                       asp-route-status="@Model.StatusFilter"
                                       asp-route-verification="@Model.VerificationFilter"
                                       asp-route-membership="@Model.MembershipFilter"
                                       asp-route-page="@p">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Users"
                                   asp-route-q="@Model.SearchQuery"
                                   asp-route-role="@Model.RoleFilter"
                                   asp-route-status="@Model.StatusFilter"
                                   asp-route-verification="@Model.VerificationFilter"
                                   asp-route-membership="@Model.MembershipFilter"
                                   asp-route-page="@(Model.Page + 1)"
                                   aria-label="Next page">
                                    Next &rarr;
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
