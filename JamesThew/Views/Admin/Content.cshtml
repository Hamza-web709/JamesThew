@model JamesThew.ViewModels.AdminEditorialListViewModel
@{
    ViewData["Title"] = "Editorial Content Management - JamesThew Admin";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Admin Dashboard</a>
        <h1 class="h2 jt-serif mt-2 mb-1">Editorial Content Management</h1>
        <p class="text-muted small mb-0">Author, edit, publish, and unpublish official Chef James Thew masterclass recipes and cooking tips.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <a asp-action="Media" class="jt-btn jt-btn-outline jt-btn-sm">
            &#128444; Media Library
        </a>
        <a asp-action="NewRecipe" class="jt-btn jt-btn-primary jt-btn-sm">
            &#127859; + New Recipe
        </a>
        <a asp-action="NewTip" class="jt-btn jt-btn-outline jt-btn-sm">
            &#128161; + New Tip
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <strong>&#10004; Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <strong>&#9888; Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Statistics -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">Active Editorial</div>
            <div class="h3 jt-serif mb-0 text-dark">@Model.TotalCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">&#127859; Recipes</div>
            <div class="h3 jt-serif mb-0 text-primary">@Model.RecipesCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">&#128161; Cooking Tips</div>
            <div class="h3 jt-serif mb-0 text-warning-emphasis">@Model.TipsCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white rounded-3 border shadow-sm text-center">
            <div class="small text-muted text-uppercase fw-semibold">Published / Drafts</div>
            <div class="h3 jt-serif mb-0 text-success">@Model.PublishedCount <span class="fs-6 text-muted font-monospace">/ @Model.DraftCount</span></div>
        </div>
    </div>
</div>

<!-- Filters and Controls -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <!-- Kind Filter -->
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a asp-action="Content" 
                   asp-route-kind="" 
                   asp-route-visibility="@Model.FilterVisibility" 
                   asp-route-status="@Model.FilterStatus" 
                   asp-route-showDeleted="@Model.ShowDeleted" 
                   class="nav-link @(Model.FilterKind == null ? "active" : "")">
                    All Kinds
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Content" 
                   asp-route-kind="@JamesThew.Models.ContentKind.Recipe" 
                   asp-route-visibility="@Model.FilterVisibility" 
                   asp-route-status="@Model.FilterStatus" 
                   asp-route-showDeleted="@Model.ShowDeleted" 
                   class="nav-link @(Model.FilterKind == JamesThew.Models.ContentKind.Recipe ? "active" : "")">
                    &#127859; Recipes Only
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Content" 
                   asp-route-kind="@JamesThew.Models.ContentKind.Tip" 
                   asp-route-visibility="@Model.FilterVisibility" 
                   asp-route-status="@Model.FilterStatus" 
                   asp-route-showDeleted="@Model.ShowDeleted" 
                   class="nav-link @(Model.FilterKind == JamesThew.Models.ContentKind.Tip ? "active" : "")">
                    &#128161; Tips Only
                </a>
            </li>
        </ul>

        <!-- Visibility and Status Filters -->
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <!-- Visibility Dropdown or Buttons -->
            <a asp-action="Content" 
               asp-route-kind="@Model.FilterKind" 
               asp-route-visibility="" 
               asp-route-status="@Model.FilterStatus" 
               asp-route-showDeleted="@Model.ShowDeleted" 
               class="btn btn-sm @(Model.FilterVisibility == null ? "btn-dark" : "btn-outline-secondary")">
                All Tiers
            </a>
            <a asp-action="Content" 
               asp-route-kind="@Model.FilterKind" 
               asp-route-visibility="@JamesThew.Models.ContentVisibility.Free" 
               asp-route-status="@Model.FilterStatus" 
               asp-route-showDeleted="@Model.ShowDeleted" 
               class="btn btn-sm @(Model.FilterVisibility == JamesThew.Models.ContentVisibility.Free ? "btn-success" : "btn-outline-success")">
                Free
            </a>
            <a asp-action="Content" 
               asp-route-kind="@Model.FilterKind" 
               asp-route-visibility="@JamesThew.Models.ContentVisibility.MembersOnly" 
               asp-route-status="@Model.FilterStatus" 
               asp-route-showDeleted="@Model.ShowDeleted" 
               class="btn btn-sm @(Model.FilterVisibility == JamesThew.Models.ContentVisibility.MembersOnly ? "btn-info" : "btn-outline-info")">
                &#128274; Members-Only
            </a>

            <span class="text-muted mx-1">|</span>

            <!-- Status Buttons -->
            <a asp-action="Content" 
               asp-route-kind="@Model.FilterKind" 
               asp-route-visibility="@Model.FilterVisibility" 
               asp-route-status="" 
               asp-route-showDeleted="@Model.ShowDeleted" 
               class="btn btn-sm @(Model.FilterStatus == null ? "btn-dark" : "btn-outline-secondary")">
                All Statuses
            </a>
            <a asp-action="Content" 
               asp-route-kind="@Model.FilterKind" 
               asp-route-visibility="@Model.FilterVisibility" 
               asp-route-status="@JamesThew.Models.PublicationStatus.Published" 
               asp-route-showDeleted="@Model.ShowDeleted" 
               class="btn btn-sm @(Model.FilterStatus == JamesThew.Models.PublicationStatus.Published ? "btn-success" : "btn-outline-success")">
                Published
            </a>
            <a asp-action="Content" 
               asp-route-kind="@Model.FilterKind" 
               asp-route-visibility="@Model.FilterVisibility" 
               asp-route-status="@JamesThew.Models.PublicationStatus.Draft" 
               asp-route-showDeleted="@Model.ShowDeleted" 
               class="btn btn-sm @(Model.FilterStatus == JamesThew.Models.PublicationStatus.Draft ? "btn-secondary" : "btn-outline-secondary")">
                Draft
            </a>

            <span class="text-muted mx-1">|</span>

            <!-- Show Deleted Toggle -->
            <a asp-action="Content" 
               asp-route-kind="@Model.FilterKind" 
               asp-route-visibility="@Model.FilterVisibility" 
               asp-route-status="@Model.FilterStatus" 
               asp-route-showDeleted="@(!Model.ShowDeleted)" 
               class="btn btn-sm @(Model.ShowDeleted ? "btn-danger" : "btn-outline-danger")">
                @(Model.ShowDeleted ? "Showing Removed (\u2714)" : "\uD83D\uDDD1 View Removed")
            </a>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th style="width: 110px;">Kind</th>
                    <th>Title &amp; Gastronomic Details</th>
                    <th style="width: 130px;">Access Tier</th>
                    <th style="width: 120px;">Status</th>
                    <th style="width: 130px;">Updated</th>
                    <th style="min-width: 170px;" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div style="font-size: 2.5rem;" class="mb-2">&#127859;</div>
                            <p class="mb-1 fw-semibold">No editorial content found.</p>
                            <p class="small mb-3">Create your first official recipe or cooking tip using the buttons above.</p>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="NewRecipe" class="jt-btn jt-btn-primary jt-btn-sm">+ New Recipe</a>
                                <a asp-action="NewTip" class="jt-btn jt-btn-outline jt-btn-sm">+ New Tip</a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        var isDeleted = item.DeletedAtUtc != null;
                        <tr class="@(isDeleted ? "table-danger bg-opacity-25" : "")">
                            <td class="fw-bold text-muted small">#@item.Id</td>
                            <td>
                                @if (item.Kind == JamesThew.Models.ContentKind.Recipe)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                        &#127859; Recipe
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">
                                        &#128161; Tip
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title" class="rounded-3 border object-fit-cover flex-shrink-0" style="width: 48px; height: 48px;" />
                                    }
                                    <div class="overflow-hidden">
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 420px;">@item.Title</div>
                                        <div class="small text-muted font-monospace text-truncate" style="max-width: 420px;">
                                            /@(item.Kind == JamesThew.Models.ContentKind.Recipe ? "recipes" : "tips")/@item.Slug
                                        </div>
                                        <div class="small text-secondary text-truncate" style="max-width: 420px;">
                                            @item.Summary
                                        </div>
                                        @if (item.Kind == JamesThew.Models.ContentKind.Recipe)
                                        {
                                            <div class="small text-muted mt-1">
                                                <span>&#9201; Prep: @(item.PrepMinutes ?? 0)m</span>
                                                <span class="mx-1">&bull;</span>
                                                <span>Cook: @(item.CookMinutes ?? 0)m</span>
                                                <span class="mx-1">&bull;</span>
                                                <span>Servings: @(item.Servings ?? 0)</span>
                                                <span class="mx-1">&bull;</span>
                                                <span>@item.IngredientsCount ingr.</span>
                                                <span class="mx-1">&bull;</span>
                                                <span>@item.StepsCount steps</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.Visibility == JamesThew.Models.ContentVisibility.Free)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                        Free
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill">
                                        &#128274; Members-Only
                                    </span>
                                }
                            </td>
                            <td>
                                @if (isDeleted)
                                {
                                    <span class="badge bg-danger rounded-pill">Removed</span>
                                    <div class="small text-danger font-monospace">@item.DeletedAtUtc?.ToString("MMM dd, HH:mm")</div>
                                }
                                else if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Published)
                                {
                                    <span class="badge bg-success rounded-pill">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">Draft</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @(item.UpdatedAtUtc?.ToString("MMM dd, yyyy") ?? item.CreatedAtUtc.ToString("MMM dd, yyyy"))
                            </td>
                            <td class="text-end">
                                @if (isDeleted)
                                {
                                    <form asp-action="RestoreContent" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            &#8635; Restore
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="btn-group btn-group-sm">
                                        @if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Published)
                                        {
                                            <a href="/@(item.Kind == JamesThew.Models.ContentKind.Recipe ? "recipes" : "tips")/@item.Slug" 
                                               target="_blank" 
                                               class="btn btn-outline-secondary" 
                                               title="View live publication">
                                                &#128065; View
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-secondary disabled" title="Draft is not public">
                                                &#128065; Draft
                                            </button>
                                        }

                                        <a asp-action="@(item.Kind == JamesThew.Models.ContentKind.Recipe ? "EditRecipe" : "EditTip")" 
                                           asp-route-id="@item.Id" 
                                           class="btn btn-outline-dark">
                                            Edit
                                        </a>

                                        <button type="button" 
                                                class="btn btn-outline-danger" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#removeModal-@item.Id" 
                                                title="Unpublish and remove">
                                            Remove
                                        </button>
                                    </div>

                                    <!-- Remove Confirmation Modal -->
                                    <div class="modal fade text-start" id="removeModal-@item.Id" tabindex="-1" aria-labelledby="removeModalLabel-@item.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-bottom-0 pb-0">
                                                    <h5 class="modal-title jt-serif text-danger" id="removeModalLabel-@item.Id">
                                                        &#9888; Remove Editorial Content
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    <p class="mb-2">Are you sure you want to remove <strong>&ldquo;@item.Title&rdquo;</strong>?</p>
                                                    <div class="alert alert-warning small mb-3">
                                                        <strong>Policy:</strong> This action will immediately <strong>unpublish</strong> the content.
                                                        It will disappear from public recipe/tip catalogs and search. Direct visits to <code>/@(item.Kind == JamesThew.Models.ContentKind.Recipe ? "recipes" : "tips")/@item.Slug</code> will return HTTP 404.
                                                        You can restore it anytime from the Removed Content view.
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-top-0 pt-0">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="RemoveContent" asp-route-id="@item.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">
                                                            Yes, Remove / Unpublish
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
