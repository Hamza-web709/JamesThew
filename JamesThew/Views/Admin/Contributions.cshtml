@model JamesThew.ViewModels.AdminContributionListViewModel
@{
    ViewData["Title"] = "Community Contributions Review - JamesThew Admin";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Admin Dashboard</a>
        <h1 class="h2 jt-serif mt-2 mb-1">Community Content Intake</h1>
        <p class="text-muted small mb-0">Read-only moderation intake for member-submitted recipes and cooking tips. Submissions remain unlisted until published in Phase 4.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
            &#9888; @Model.PendingCount Pending Contributions
        </span>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a asp-action="Contributions" asp-route-kind="" class="nav-link @(Model.FilterKind == null ? "active" : "")">
                    All Intake (@Model.TotalCount)
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Contributions" asp-route-kind="@JamesThew.Models.ContentKind.Recipe" class="nav-link @(Model.FilterKind == JamesThew.Models.ContentKind.Recipe ? "active" : "")">
                    Recipes Only
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Contributions" asp-route-kind="@JamesThew.Models.ContentKind.Tip" class="nav-link @(Model.FilterKind == JamesThew.Models.ContentKind.Tip ? "active" : "")">
                    Cooking Tips Only
                </a>
            </li>
        </ul>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Title &amp; Summary</th>
                    <th>Contributor</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div style="font-size: 2.5rem;" class="mb-2">&#127859;</div>
                            <p class="mb-0">No community contributions found matching this filter.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-bold text-muted small">#@item.Id</td>
                            <td>
                                @if (item.Kind == JamesThew.Models.ContentKind.Recipe)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">&#127859; Recipe</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">&#128161; Tip</span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@item.Title</div>
                                <div class="small text-muted text-truncate" style="max-width: 320px;">@item.Summary</div>
                                @if (item.Kind == JamesThew.Models.ContentKind.Recipe)
                                {
                                    <div class="small text-muted mt-1">
                                        Servings: @(item.Servings?.ToString() ?? "—") | Prep: @(item.PrepMinutes?.ToString() ?? "—")m | Cook: @(item.CookMinutes?.ToString() ?? "—")m
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@item.AuthorDisplayName</div>
                                <div class="small text-muted">@item.AuthorEmail</div>
                            </td>
                            <td class="text-nowrap small text-muted">@item.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                @if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Pending)
                                {
                                    <span class="jt-badge" style="background-color: #FEF3C7; color: #92400E; border: 1px solid #FCD34D;">
                                        Pending Review
                                    </span>
                                }
                                else if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Published)
                                {
                                    <span class="jt-badge jt-badge-free">Published</span>
                                }
                                else
                                {
                                    <span class="jt-badge" style="background-color: #FEE2E2; color: #991B1B;">
                                        @(item.PublicationStatus.ToString())
                                    </span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#details-@item.Id" aria-expanded="false" aria-controls="details-@item.Id">
                                    View Content &#9662;
                                </button>
                            </td>
                        </tr>
                        <tr class="collapse bg-light" id="details-@item.Id">
                            <td colspan="7" class="p-4">
                                <div class="bg-white p-3 rounded-3 border">
                                    <h4 class="h6 jt-serif mb-2">Content Preview: @item.Title</h4>
                                    <p class="small text-muted mb-3"><strong>Summary:</strong> @item.Summary</p>

                                    @if (item.Kind == JamesThew.Models.ContentKind.Recipe)
                                    {
                                        <div class="row g-3">
                                            <div class="col-md-5">
                                                <h5 class="small fw-bold text-uppercase text-muted">Ingredients (@item.Ingredients.Count)</h5>
                                                <ul class="small mb-0 ps-3">
                                                    @foreach (var ing in item.Ingredients)
                                                    {
                                                        <li>@ing</li>
                                                    }
                                                </ul>
                                            </div>
                                            <div class="col-md-7">
                                                <h5 class="small fw-bold text-uppercase text-muted">Preparation Steps (@item.Steps.Count)</h5>
                                                <ol class="small mb-0 ps-3">
                                                    @foreach (var step in item.Steps)
                                                    {
                                                        <li class="mb-1">@step</li>
                                                    }
                                                </ol>
                                            </div>
                                        </div>
                                    }
                                    else if (item.Kind == JamesThew.Models.ContentKind.Tip)
                                    {
                                        <div>
                                            <h5 class="small fw-bold text-uppercase text-muted">Tip Body / Technique</h5>
                                            <div class="small p-3 bg-light rounded border text-break" style="white-space: pre-line;">@item.TipBody</div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <div class="mt-3 pt-2 border-top">
                                            <span class="small fw-bold text-muted">Contributor Notes:</span>
                                            <span class="small text-muted">@item.Notes</span>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
