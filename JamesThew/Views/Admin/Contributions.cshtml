@model JamesThew.ViewModels.AdminContributionListViewModel
@{
    ViewData["Title"] = "Community Contributions Moderation - JamesThew Admin";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Admin Dashboard</a>
        <h1 class="h2 jt-serif mt-2 mb-1">Community Content Moderation</h1>
        <p class="text-muted small mb-0">Review, approve and publish or reject member-submitted recipes and cooking tips.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
            &#9888; @Model.PendingCount Pending Contributions
        </span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <strong>&#10004; Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <strong>&#9888; Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a asp-action="Contributions" asp-route-kind="" asp-route-status="@Model.FilterStatus" class="nav-link @(Model.FilterKind == null ? "active" : "")">
                    All Kinds (@Model.TotalCount)
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Contributions" asp-route-kind="@JamesThew.Models.ContentKind.Recipe" asp-route-status="@Model.FilterStatus" class="nav-link @(Model.FilterKind == JamesThew.Models.ContentKind.Recipe ? "active" : "")">
                    &#127859; Recipes Only
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Contributions" asp-route-kind="@JamesThew.Models.ContentKind.Tip" asp-route-status="@Model.FilterStatus" class="nav-link @(Model.FilterKind == JamesThew.Models.ContentKind.Tip ? "active" : "")">
                    &#128161; Tips Only
                </a>
            </li>
        </ul>

        <div class="d-flex gap-2">
            <a asp-action="Contributions" asp-route-kind="@Model.FilterKind" asp-route-status="" class="btn btn-sm @(Model.FilterStatus == null ? "btn-dark" : "btn-outline-secondary")">
                All Statuses
            </a>
            <a asp-action="Contributions" asp-route-kind="@Model.FilterKind" asp-route-status="@JamesThew.Models.PublicationStatus.Pending" class="btn btn-sm @(Model.FilterStatus == JamesThew.Models.PublicationStatus.Pending ? "btn-warning" : "btn-outline-warning")">
                Pending (@Model.PendingCount)
            </a>
            <a asp-action="Contributions" asp-route-kind="@Model.FilterKind" asp-route-status="@JamesThew.Models.PublicationStatus.Published" class="btn btn-sm @(Model.FilterStatus == JamesThew.Models.PublicationStatus.Published ? "btn-success" : "btn-outline-success")">
                Published
            </a>
            <a asp-action="Contributions" asp-route-kind="@Model.FilterKind" asp-route-status="@JamesThew.Models.PublicationStatus.Rejected" class="btn btn-sm @(Model.FilterStatus == JamesThew.Models.PublicationStatus.Rejected ? "btn-danger" : "btn-outline-danger")">
                Rejected
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Title &amp; Summary</th>
                    <th>Contributor</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th style="min-width: 140px;">Review &amp; Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div style="font-size: 2.5rem;" class="mb-2">&#127859;</div>
                            <p class="mb-0">No community contributions found matching this filter.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-bold text-muted small">#@item.Id</td>
                            <td>
                                @if (item.Kind == JamesThew.Models.ContentKind.Recipe)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">&#127859; Recipe</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">&#128161; Tip</span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@item.Title</div>
                                <div class="small text-muted text-truncate" style="max-width: 320px;">@item.Summary</div>
                                @if (item.Kind == JamesThew.Models.ContentKind.Recipe)
                                {
                                    <div class="small text-muted mt-1">
                                        Servings: @(item.Servings?.ToString() ?? "—") | Prep: @(item.PrepMinutes?.ToString() ?? "—")m | Cook: @(item.CookMinutes?.ToString() ?? "—")m
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@item.AuthorDisplayName</div>
                                <div class="small text-muted">@item.AuthorEmail</div>
                            </td>
                            <td class="text-nowrap small text-muted">@item.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                @if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Pending)
                                {
                                    <span class="jt-badge" style="background-color: #FEF3C7; color: #92400E; border: 1px solid #FCD34D;">
                                        Pending Review
                                    </span>
                                }
                                else if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Published)
                                {
                                    <span class="jt-badge jt-badge-free">&#10004; Published</span>
                                    @if (item.Visibility == JamesThew.Models.ContentVisibility.MembersOnly)
                                    {
                                        <span class="badge bg-dark ms-1">Members-Only</span>
                                    }
                                }
                                else
                                {
                                    <span class="jt-badge" style="background-color: #FEE2E2; color: #991B1B;">
                                        &#10006; Rejected
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 align-items-center">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#details-@item.Id" aria-expanded="false" aria-controls="details-@item.Id">
                                        Inspect &#9662;
                                    </button>
                                    @if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Published)
                                    {
                                        <a href="@(item.Kind == JamesThew.Models.ContentKind.Recipe ? $"/recipes/{item.Slug}" : $"/tips/{item.Slug}")" target="_blank" class="btn btn-sm btn-outline-success">
                                            View &rarr;
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                        <tr class="collapse bg-light" id="details-@item.Id">
                            <td colspan="7" class="p-4">
                                <div class="bg-white p-3 rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                        <h4 class="h6 jt-serif mb-0">Submission Review: @item.Title</h4>
                                        <span class="text-muted small">Slug: <code>@item.Slug</code></span>
                                    </div>
                                    <p class="small text-muted mb-3"><strong>Summary:</strong> @item.Summary</p>

                                    @if (item.Kind == JamesThew.Models.ContentKind.Recipe)
                                    {
                                        <div class="row g-3">
                                            <div class="col-md-5">
                                                <h5 class="small fw-bold text-uppercase text-muted">Ingredients (@item.Ingredients.Count)</h5>
                                                <ul class="small mb-0 ps-3">
                                                    @foreach (var ing in item.Ingredients)
                                                    {
                                                        <li>@ing</li>
                                                    }
                                                </ul>
                                            </div>
                                            <div class="col-md-7">
                                                <h5 class="small fw-bold text-uppercase text-muted">Preparation Steps (@item.Steps.Count)</h5>
                                                <ol class="small mb-0 ps-3">
                                                    @foreach (var step in item.Steps)
                                                    {
                                                        <li class="mb-1">@step</li>
                                                    }
                                                </ol>
                                            </div>
                                        </div>
                                    }
                                    else if (item.Kind == JamesThew.Models.ContentKind.Tip)
                                    {
                                        <div>
                                            <h5 class="small fw-bold text-uppercase text-muted">Tip Body / Technique</h5>
                                            <div class="small p-3 bg-light rounded border text-break" style="white-space: pre-line;">@item.TipBody</div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <div class="mt-3 pt-2 border-top">
                                            <span class="small fw-bold text-muted">Contributor Notes:</span>
                                            <span class="small text-muted">@item.Notes</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.RejectionReason))
                                    {
                                        <div class="mt-3 p-2 bg-danger-subtle rounded border border-danger-subtle">
                                            <span class="small fw-bold text-danger">Rejection Reason:</span>
                                            <span class="small text-danger-emphasis">@item.RejectionReason</span>
                                        </div>
                                    }

                                    <div class="mt-4 pt-3 border-top bg-light p-3 rounded-3">
                                        <h6 class="small fw-bold text-uppercase text-muted mb-3">Editorial Moderation Actions</h6>

                                        @if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Pending)
                                        {
                                            <div class="row g-3 align-items-center">
                                                <div class="col-md-5">
                                                    <form asp-action="ApproveContribution" asp-route-id="@item.Id" method="post" class="d-flex align-items-center gap-2">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="visibility" value="@JamesThew.Models.ContentVisibility.Free" />
                                                        <button type="submit" class="btn btn-success btn-sm">
                                                            &#10004; Approve &amp; Publish (Free)
                                                        </button>
                                                    </form>
                                                </div>
                                                <div class="col-md-7">
                                                    <form asp-action="RejectContribution" asp-route-id="@item.Id" method="post" class="d-flex gap-2">
                                                        @Html.AntiForgeryToken()
                                                        <input type="text" name="rejectionReason" class="form-control form-control-sm" placeholder="Reason for rejection (e.g. missing prep details)..." maxlength="500" required />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap">
                                                            &#10006; Reject
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        else if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Published)
                                        {
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="small text-success fw-bold">&#10004; This contribution is live on the public site as @item.Visibility content.</span>
                                                <form asp-action="RejectContribution" asp-route-id="@item.Id" method="post" class="d-flex gap-2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="text" name="rejectionReason" class="form-control form-control-sm" placeholder="Reason to unpublish/reject..." maxlength="500" required />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap">
                                                        Unpublish &amp; Reject
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="small text-danger fw-bold">&#10006; Rejected. Not visible publicly.</span>
                                                <form asp-action="ApproveContribution" asp-route-id="@item.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="visibility" value="@JamesThew.Models.ContentVisibility.Free" />
                                                    <button type="submit" class="btn btn-outline-success btn-sm">
                                                        Re-approve &amp; Publish (Free)
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
