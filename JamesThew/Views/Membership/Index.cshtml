@model JamesThew.ViewModels.SubscriptionRequestViewModel
@using JamesThew.Models
@{
    ViewData["Title"] = "Membership & Masterclass Subscriptions";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
}

<!-- Fixed Membership Background Layer (Family C - Membership) -->
<div class="jt-page-backdrop" aria-hidden="true">
    <div class="jt-page-bg-img" style="background-image: url('@Url.Content("~/assets/inner-pages/backgrounds/bg-membership.webp")');"></div>
    <div class="jt-page-overlay"></div>
    <div class="jt-page-vignette"></div>
</div>

<div class="jt-inner-shell">
    <div class="jt-inner-container-md">

        <!-- Page Hero -->
        <div class="jt-page-hero">
            <span class="jt-page-eyebrow">
                <span class="jt-eyebrow-line" aria-hidden="true"></span>
                Culinary Masterclasses
            </span>
            <h1 class="jt-page-title">Membership Plans &amp; <span class="jt-serif-italic">Benefits</span></h1>
            <p class="jt-page-lead">
                Unlock Chef James Thew's complete collection of culinary secrets, precise ingredient measurements, and advanced technique masterclasses.
            </p>
        </div>

        <!-- Academic Demonstration Notice (Preserved & Elegantly Restyled) -->
        <div class="jt-academic-disclaimer mb-5">
            <div class="d-flex align-items-start gap-3">
                <span class="jt-badge-demo-pill">&#9888; Academic Demo Notice</span>
                <p class="mb-0 small text-light-muted">
                    All subscription plans are simulated for demonstration purposes. No real monetary transactions, credit card numbers, or external payment gateways are used. Plan requests are reviewed and approved manually by the site administrator.
                </p>
            </div>
        </div>

        <!-- System Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success jt-glass-alert mb-4" role="alert">
                <strong>Success:</strong> @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger jt-glass-alert mb-4" role="alert">
                <strong>Notice:</strong> @TempData["ErrorMessage"]
            </div>
        }

        <!-- Current Status Banner for Logged-in Users -->
        @if (Model.IsAuthenticated)
        {
            <div class="jt-glass-panel mb-5">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <h2 class="h5 jt-serif mb-0 text-light">Your Membership Status</h2>
                    <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 px-3 py-1">
                        Signed In
                    </span>
                </div>

                @if (Model.HasActiveSubscription)
                {
                    <div class="p-4 rounded-3 border mb-3" style="background: rgba(34, 197, 94, 0.12); border-color: rgba(34, 197, 94, 0.35) !important;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-success text-white px-3 py-1">&#10004; Active Premium Access</span>
                            <span class="fw-bold text-success">@Model.CurrentPlan Plan ($@(Model.CurrentAmount?.ToString("F2") ?? "0.00"))</span>
                        </div>
                        <p class="small text-light-muted mb-2">
                            You have full access to all exclusive Members-Only recipes, hidden ingredient ratios, preparation steps, and cooking technique guides.
                        </p>
                        @if (Model.ExpiresAtUtc.HasValue)
                        {
                            <p class="small text-light-muted mb-3">
                                <strong>Valid Through:</strong> @Model.ExpiresAtUtc.Value.ToLocalTime().ToString("f")
                            </p>
                        }
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Recipes" asp-action="Index" asp-route-visibility="MembersOnly" class="jt-btn-editorial jt-btn-gold">
                                Browse Masterclass Recipes &rarr;
                            </a>
                            <a asp-controller="Tips" asp-action="Index" asp-route-visibility="MembersOnly" class="jt-btn-editorial jt-btn-outline-light">
                                Browse Masterclass Tips &rarr;
                            </a>
                        </div>
                    </div>
                }
                else if (Model.CurrentStatus == SubscriptionStatus.Pending)
                {
                    <div class="p-4 rounded-3 border mb-3" style="background: rgba(245, 158, 11, 0.12); border-color: rgba(245, 158, 11, 0.35) !important;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-warning text-dark px-3 py-1">&#9203; Pending Approval</span>
                            <span class="fw-bold text-warning">@Model.CurrentPlan Plan ($@(Model.CurrentAmount?.ToString("F2") ?? "0.00"))</span>
                        </div>
                        <p class="small text-light-muted mb-2">
                            Your demo subscription request was received on @Model.LatestRequestedAtUtc?.ToLocalTime().ToString("f") and is currently in the administrator moderation queue.
                        </p>
                        @if (!string.IsNullOrEmpty(Model.LatestMemberNotes))
                        {
                            <p class="small text-light-muted mb-2">
                                <strong>Submitted Notes / Reference:</strong> @Model.LatestMemberNotes
                            </p>
                        }
                        <p class="small text-light-muted mb-0">
                            Once the administrator verifies your demo request, your account will instantly unlock all protected masterclasses.
                        </p>
                    </div>
                }
                else if (Model.CurrentStatus == SubscriptionStatus.Rejected)
                {
                    <div class="p-4 rounded-3 border mb-3" style="background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.35) !important;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-danger text-white px-3 py-1">&#10006; Request Not Approved</span>
                            <span class="fw-bold text-danger">@Model.CurrentPlan Plan</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.LatestAdminNotes))
                        {
                            <p class="small text-light-muted mb-2">
                                <strong>Administrator Feedback:</strong> @Model.LatestAdminNotes
                            </p>
                        }
                        <p class="small text-light-muted mb-0">
                            You may select a plan below to submit a new subscription request for administrator review.
                        </p>
                    </div>
                }
                else
                {
                    <div class="p-3 rounded-3 border mb-3" style="background: rgba(255, 255, 255, 0.04); border-color: var(--jt-charcoal-border) !important;">
                        <span class="badge bg-secondary text-light mb-2 d-inline-block">Standard Member</span>
                        <p class="small text-light-muted mb-0">
                            You are signed in with a standard Member account. You currently have access to all Free recipes and tips. To unlock Members-Only masterclasses, select a plan below.
                        </p>
                    </div>
                }
            </div>
        }

        <!-- Plan Pricing Comparison Cards (2-Card Glass Architecture) -->
        <div class="row g-4 mb-5">
            <!-- Monthly Plan -->
            <div class="col-md-6">
                <div class="jt-glass-panel jt-card-interactive-utility h-100 d-flex flex-column justify-content-between position-relative">
                    <div class="jt-card-spotlight" aria-hidden="true"></div>
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="jt-page-eyebrow mb-0">Flexible Access</span>
                        </div>
                        <h3 class="h4 jt-serif mb-2 text-light">Monthly Masterclass</h3>
                        <div class="display-6 fw-bold mb-3 jt-serif" style="color: var(--jt-gold-primary);">
                            $10 <span class="fs-6 fw-normal text-light-muted">/ month</span>
                        </div>
                        <p class="text-light-secondary small mb-4">
                            Ideal for home culinarians exploring seasonal techniques, weekly masterclasses, and foundational tips.
                        </p>

                        <ul class="list-unstyled small mb-4 text-light-secondary">
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <span class="text-success">&#10004;</span> Full access to all Cookery Recipes
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <span class="text-success">&#10004;</span> Secret ingredients &amp; exact prep ratios
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <span class="text-success">&#10004;</span> Professional cooking tip guides
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <span class="text-success">&#10004;</span> Simulated 30-day demo access
                            </li>
                        </ul>
                    </div>

                    @if (!Model.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/membership" class="jt-btn-editorial jt-btn-outline-light w-100 text-center">
                            Sign In to Choose Plan
                        </a>
                    }
                </div>
            </div>

            <!-- Yearly Plan (Pinnacle Card) -->
            <div class="col-md-6">
                <div class="jt-glass-panel jt-glass-panel-pinnacle jt-card-interactive-utility h-100 d-flex flex-column justify-content-between position-relative">
                    <div class="jt-card-spotlight" aria-hidden="true"></div>
                    <div class="position-absolute top-0 end-0 translate-middle-y me-3">
                        <span class="jt-badge-gold-pill">Best Value &bull; Save $20</span>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="jt-page-eyebrow mb-0">Annual Access</span>
                        </div>
                        <h3 class="h4 jt-serif mb-2 text-light">Yearly Connoisseur</h3>
                        <div class="display-6 fw-bold mb-3 jt-serif" style="color: var(--jt-gold-primary);">
                            $100 <span class="fs-6 fw-normal text-light-muted">/ year</span>
                        </div>
                        <p class="text-light-secondary small mb-4">
                            Unrestricted 365-day access to James Thew's complete culinary archive, knife wisdom, and fine-dining archives.
                        </p>

                        <ul class="list-unstyled small mb-4 text-light-secondary">
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <span class="text-success">&#10004;</span> Everything in Monthly Plan included
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <span class="text-success">&#10004;</span> Priority demonstration queue review
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <span class="text-success">&#10004;</span> Unrestricted 365-day demo validity
                            </li>
                            <li class="mb-2 d-flex align-items-center gap-2">
                                <span class="text-success">&#10004;</span> Access to future masterclass updates
                            </li>
                        </ul>
                    </div>

                    @if (!Model.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/membership" class="jt-btn-editorial jt-btn-gold w-100 text-center">
                            Sign In to Choose Plan
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Request Form for Logged-In Members without an Active/Pending Request -->
        @if (Model.IsAuthenticated && !Model.HasActiveSubscription && Model.CurrentStatus != SubscriptionStatus.Pending)
        {
            <div class="jt-glass-panel mb-5">
                <h2 class="h4 jt-serif mb-2 text-light">Submit Demo Subscription Request</h2>
                <p class="text-light-secondary small mb-4">
                    Select your preferred tier below. Your request will be queued for manual administrative review.
                </p>

                <form asp-action="Subscribe" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-light-muted d-block mb-3">Select Subscription Tier</label>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="jt-plan-radio-label">
                                    <input type="radio" asp-for="Plan" value="@SubscriptionPlan.Monthly" checked="checked" class="jt-radio-input" />
                                    <div>
                                        <div class="fw-bold text-light">Monthly Plan</div>
                                        <div class="small text-light-muted">$10.00 / month (30-day demo)</div>
                                    </div>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="jt-plan-radio-label">
                                    <input type="radio" asp-for="Plan" value="@SubscriptionPlan.Yearly" class="jt-radio-input" />
                                    <div>
                                        <div class="fw-bold text-light">Yearly Plan</div>
                                        <div class="small text-light-muted">$100.00 / year (365-day demo)</div>
                                    </div>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="Plan" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="jt-form-label">Demo Notes or Reference (Optional)</label>
                        <textarea asp-for="Notes" class="jt-form-input" rows="3" placeholder="e.g. Academic evaluation request, demo voucher #4521..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                        <div class="form-text text-light-muted small mt-1">Please do not enter real credit card numbers or banking secrets.</div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pt-2">
                        <button type="submit" class="jt-btn-editorial jt-btn-gold">
                            <span>Submit Demo Request</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </button>
                        <span class="small text-light-muted">&#128274; Safe Academic Demo Environment</span>
                    </div>
                </form>
            </div>
        }

        <!-- Subscription History Table -->
        @if (Model.IsAuthenticated && Model.History.Count > 0)
        {
            <div class="jt-glass-panel mb-5">
                <h3 class="h5 jt-serif mb-3 text-light">Your Request History</h3>
                <div class="table-responsive">
                    <table class="table table-dark table-borderless align-middle mb-0" style="background: transparent;">
                        <thead>
                            <tr class="small text-light-muted text-uppercase border-bottom border-secondary border-opacity-25">
                                <th>Plan</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Submitted</th>
                                <th>Member Notes</th>
                                <th>Expires</th>
                                <th>Admin Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.History)
                            {
                                <tr class="border-bottom border-secondary border-opacity-10">
                                    <td class="fw-bold text-light">@item.Plan</td>
                                    <td class="text-light-primary">$@item.Amount.ToString("F2")</td>
                                    <td>
                                        @if (item.Status == SubscriptionStatus.Approved)
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (item.Status == SubscriptionStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                    </td>
                                    <td class="small text-light-muted">@item.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                    <td class="small text-light-secondary">@(string.IsNullOrEmpty(item.Notes) ? "—" : item.Notes)</td>
                                    <td class="small text-light-muted">@(item.ExpiresAtUtc.HasValue ? item.ExpiresAtUtc.Value.ToLocalTime().ToString("g") : "—")</td>
                                    <td class="small text-light-secondary">@(string.IsNullOrEmpty(item.AdminNotes) ? "—" : item.AdminNotes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script src="~/js/public-pages.js" asp-append-version="true"></script>
}
