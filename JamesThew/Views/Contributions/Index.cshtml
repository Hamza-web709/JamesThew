@model JamesThew.ViewModels.MemberContributionsIndexViewModel
@{
    ViewData["Title"] = "My Culinary Contributions - Community Recipe & Tip Intake";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <span class="jt-brand-tag">Member Submissions</span>
        <h1 class="h2 jt-serif mb-1">My Culinary Contributions</h1>
        <p class="text-muted small mb-0">Share your favorite artisanal recipes and professional kitchen tips with the James Thew community.</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a asp-action="NewRecipe" class="jt-btn jt-btn-primary" id="btnSubmitNewRecipe">
            &#127859; Submit Recipe
        </a>
        <a asp-action="NewTip" class="jt-btn jt-btn-accent" id="btnSubmitNewTip">
            &#128161; Submit Cooking Tip
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <strong>&#10004; Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-5">
    <div class="col-lg-8">
        <div class="p-4 bg-white rounded-4 border shadow-sm">
            <h2 class="h5 jt-serif mb-3">Submitted Contributions (@Model.TotalCount)</h2>

            @if (Model.Items.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <div style="font-size: 3rem;" class="mb-2">&#128221;</div>
                    <h3 class="h6 mb-2">No contributions yet</h3>
                    <p class="small max-w-500 mx-auto mb-4">
                        You have not submitted any recipes or cooking tips yet. Click one of the buttons above to share your culinary creations with Chef James Thew!
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="NewRecipe" class="jt-btn jt-btn-primary jt-btn-sm">Submit First Recipe</a>
                        <a asp-action="NewTip" class="jt-btn jt-btn-outline jt-btn-sm">Submit First Tip</a>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Type</th>
                                <th>Title</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        @if (item.Kind == JamesThew.Models.ContentKind.Recipe)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Recipe</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Tip</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.Title</div>
                                        <div class="small text-muted text-truncate" style="max-width: 320px;">@item.Summary</div>
                                    </td>
                                    <td class="text-nowrap small text-muted">@item.CreatedAtUtc.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Pending)
                                        {
                                            <span class="jt-badge" style="background-color: #FEF3C7; color: #92400E; border: 1px solid #FCD34D;">
                                                &#128337; Pending Review
                                            </span>
                                        }
                                        else if (item.PublicationStatus == JamesThew.Models.PublicationStatus.Published)
                                        {
                                            <span class="jt-badge jt-badge-free">&#10004; Published</span>
                                            <a href="@(item.Kind == JamesThew.Models.ContentKind.Recipe ? $"/recipes/{item.Slug}" : $"/tips/{item.Slug}")" class="small ms-2 text-success fw-bold text-decoration-none">
                                                View Live &rarr;
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="jt-badge" style="background-color: #FEE2E2; color: #991B1B;">
                                                &#10006; Rejected
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(item.RejectionReason))
                                            {
                                                <div class="small text-danger mt-1">
                                                    <strong>Editorial Note:</strong> @item.RejectionReason
                                                </div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="p-4 bg-white rounded-4 border shadow-sm mb-4">
            <h3 class="h6 jt-serif mb-2">&#128737; Submission &amp; Moderation Policy</h3>
            <p class="small text-muted mb-3">
                All submitted community recipes and tips undergo editorial review by the James Thew moderation team before being published.
            </p>
            <ul class="small text-muted ps-3 mb-0">
                <li class="mb-2"><strong>Pending Review:</strong> While in pending status, your submissions are securely stored and will <em>not</em> appear in the public recipe or tips catalog.</li>
                <li class="mb-2"><strong>Free for Everyone:</strong> Once approved by the administrator, community contributions are published as Free content accessible to all site visitors.</li>
                <li class="mb-2"><strong>Editorial Integrity:</strong> Please provide clear ingredient measurements and step-by-step instructions.</li>
            </ul>
        </div>
    </div>
</div>
