@model JamesThew.ViewModels.TipContributionViewModel
@{
    ViewData["Title"] = "Submit Cooking Tip Contribution - JamesThew";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
}

<div class="jt-page-backdrop" aria-hidden="true">
    <div class="jt-page-bg-img" style="background-image: url('@Url.Content("~/assets/inner-pages/backgrounds/bg-community.webp")');"></div>
    <div class="jt-page-overlay"></div>
    <div class="jt-page-vignette"></div>
</div>

<div class="jt-inner-shell jt-member-page">
    <div class="jt-inner-container">


<div class="max-w-860 mx-auto mb-5">
    <div class="mb-4">
        <a asp-action="Index" class="jt-member-back-link text-decoration-none small">&larr; Back to Contributions</a>
        <h1 class="jt-page-title jt-serif mt-2 mb-1">Submit a Cooking Tip Contribution</h1>
        <p class="text-muted small">Share professional kitchen wisdom, knife techniques, or culinary science tips with the James Thew community.</p>
    </div>

    <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm jt-glass-panel jt-member-panel jt-card-interactive-utility position-relative"><div class="jt-card-spotlight" aria-hidden="true"></div>
        <form asp-action="NewTip" method="post" id="tipContributionForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

            <div class="mb-3">
                <label asp-for="Title" class="jt-member-label form-label fw-bold small text-uppercase">Tip Title</label>
                <input asp-for="Title" class="jt-member-input form-control form-control-lg" placeholder="e.g., Preserving Fresh Herbs with Cold Water Herb Wells" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Summary" class="jt-member-label form-label fw-bold small text-uppercase">Brief Summary</label>
                <textarea asp-for="Summary" class="jt-member-input form-control" rows="2" placeholder="A concise 1-2 sentence overview explaining the benefit of this technique..."></textarea>
                <span asp-validation-for="Summary" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Body" class="jt-member-label form-label fw-bold small text-uppercase">Full Tip &amp; Technique Instructions</label>
                <textarea asp-for="Body" class="jt-member-input form-control" rows="8" placeholder="Explain the technique in detail:&#10;&#10;1. Equipment needed (e.g., glass jar, damp towel, shears).&#10;2. Step-by-step instructions.&#10;3. Culinary science explanation (why it works).&#10;4. Common pitfalls to avoid."></textarea>
                <div class="form-text small">Please provide at least 20 characters of clear culinary guidance.</div>
                <span asp-validation-for="Body" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Notes" class="jt-member-label form-label fw-bold small text-uppercase">Contributor Notes / Category (Optional)</label>
                <input asp-for="Notes" class="jt-member-input form-control" placeholder="e.g., Category: Kitchen Prep &amp; Storage; adapted from restaurant experience" />
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-action="Index" class="jt-btn-editorial jt-btn-outline-light">Cancel</a>
                <button type="submit" class="jt-btn-editorial jt-btn-gold" id="btnSubmitTip">
                    Submit Cooking Tip for Review &#8594;
                </button>
            </div>
        </form>
    </div>
</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/public-pages.js" asp-append-version="true"></script>
}
