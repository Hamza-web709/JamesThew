@model JamesThew.ViewModels.TipDetailViewModel
@{
    ViewData["Title"] = $"{Model.Title} - Cooking Tip by {Model.AuthorDisplayName}";
}

<article class="mb-5">
    <header class="jt-detail-header text-center max-w-700 mx-auto">
        <div class="mb-2">
            <a asp-controller="Tips" asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to all cooking tips</a>
        </div>

        <div class="d-flex justify-content-center align-items-center gap-2 mb-2">
            @if (Model.IsMembersOnly)
            {
                <span class="jt-badge jt-badge-paid">&#128274; Exclusive Masterclass Technique</span>
            }
            else
            {
                <span class="jt-badge jt-badge-free">Free Cooking Tip</span>
            }
            <span class="text-muted small">&#128197; Published @Model.CreatedAtUtc.ToString("MMMM dd, yyyy")</span>
        </div>

        <h1 class="jt-detail-title">@Model.Title</h1>

        <div class="d-flex justify-content-center align-items-center gap-3 text-muted small">
            <span>&#128100; By <strong>@Model.AuthorDisplayName</strong></span>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="jt-detail-img-box max-w-860 mx-auto mb-4">
            <img src="@Model.ImageUrl" alt="@Model.Title" class="jt-detail-img" />
        </div>
    }

    <!-- Summary Box -->
    <div class="jt-tip-reading mb-4">
        <h2 class="h6 text-uppercase fw-bold text-muted mb-2" style="letter-spacing: 1px;">Chef's Summary</h2>
        <p class="lead mb-0" style="color: var(--jt-text); font-size: 1.15rem;">@Model.Summary</p>
    </div>

    <!-- Protected Locked State vs Unlocked Content -->
    @if (Model.IsLocked)
    {
        <div class="jt-locked-box max-w-860 mx-auto" role="region" aria-label="Members Only Locked Content">
            <div class="jt-locked-icon">&#128274;</div>
            <h2 class="jt-locked-title">Exclusive Masterclass Technique</h2>
            <p class="jt-locked-desc">
                James Thew's in-depth culinary masterclass—including professional kitchen science, precision emulsion steps, and corrective troubleshooting—is reserved for registered members with an approved demo subscription.
            </p>

            <div class="jt-locked-pricing">
                <div>Monthly Plan: <span>$10 / mo</span></div>
                <div>Annual Plan: <span>$100 / yr</span></div>
            </div>

            <div class="mb-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Membership" asp-action="Index" class="jt-btn jt-btn-primary">
                        View Demo Subscription Status &rarr;
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="jt-btn jt-btn-primary">
                        Sign In to View
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="jt-btn jt-btn-outline ms-2">
                        Create Member Account
                    </a>
                }
            </div>

            <p class="small text-muted mb-0">
                <em>* Policy Notice: In accordance with project specifications, protected tip bodies require an active, approved demo subscription ($10/mo or $100/yr) or administrative review.</em>
            </p>
        </div>
    }
    else
    {
        <div class="jt-tip-reading">
            <h2 class="h5 jt-serif mb-3 border-bottom pb-2">Culinary Guide &amp; Technique</h2>
            <div class="jt-tip-body">@Model.Body</div>
        </div>
    }

    <!-- Related Tips -->
    @if (Model.RelatedTips.Count > 0)
    {
        <section class="mt-5 max-w-860 mx-auto">
            <h3 class="h4 jt-serif mb-3">More Kitchen Wisdom</h3>
            <div class="row g-3">
                @foreach (var related in Model.RelatedTips)
                {
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border h-100 shadow-sm d-flex flex-column">
                            <span class="small text-muted mb-1">&#128197; @related.CreatedAtUtc.ToString("MMM dd")</span>
                            <h4 class="h6 mb-2">
                                <a asp-controller="Tips" asp-action="Detail" asp-route-slug="@related.Slug" class="text-decoration-none text-dark">
                                    @related.Title
                                </a>
                            </h4>
                            <div class="mt-auto pt-2">
                                <a asp-controller="Tips" asp-action="Detail" asp-route-slug="@related.Slug" class="small text-danger fw-bold">
                                    Read tip &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</article>
