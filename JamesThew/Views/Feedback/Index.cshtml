@{
    ViewData["Title"] = "Feedback - Member Inquiries & Recipe Reviews";
}

<div class="text-center max-w-700 mx-auto mb-5">
    <span class="jt-brand-tag">Community Feedback</span>
    <h1 class="mb-2">Culinary Feedback &amp; Suggestions</h1>
    <p class="lead text-muted">
        Your culinary insights, questions, and recipe feedback help refine our recipes and techniques.
    </p>
</div>

<div class="p-4 p-md-5 bg-white rounded-4 border mb-5 shadow-sm max-w-860 mx-auto">
    <div class="d-flex align-items-center gap-3 mb-3">
        <span class="jt-badge jt-badge-paid">&#128337; Phase 3 Feature</span>
        <span class="text-muted small">Member-Only Access Policy</span>
    </div>

    <h2 class="h4 jt-serif mb-3">Feedback Guidelines</h2>
    <p class="text-muted">
        To maintain thoughtful gastronomic discussions and prevent automated spam, submitting feedback requires an active Member account.
    </p>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3 h-100 border">
                <h3 class="h6 mb-2">&#127860; Recipe-Specific Comments</h3>
                <p class="small text-muted mb-0">
                    Logged-in members can submit constructive comments, preparation questions, and flavor adjustments directly on accessible recipe detail pages.
                </p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3 h-100 border">
                <h3 class="h6 mb-2">&#127760; General Site Inquiries</h3>
                <p class="small text-muted mb-0">
                    Suggestions regarding portal features, culinary topics, and masterclass requests can be submitted via the site feedback form.
                </p>
            </div>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="alert alert-info">
            You are signed in as <strong>@(User.Identity.Name)</strong>. Dedicated feedback forms will be enabled in Phase 3.
        </div>
    }
    else
    {
        <div class="p-3 rounded-3 border mb-4" style="background-color: var(--jt-surface-warm);">
            <h3 class="h6 mb-1">&#128274; Sign-In Required</h3>
            <p class="small text-muted mb-2">
                Unregistered visitors cannot submit feedback directly. Please sign in or create an account to participate.
            </p>
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="jt-btn jt-btn-primary jt-btn-sm">
                Sign In
            </a>
            <a asp-controller="Account" asp-action="Register" class="jt-btn jt-btn-outline jt-btn-sm ms-2">
                Register
            </a>
        </div>
    }

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Faq" asp-action="Index" class="jt-btn jt-btn-secondary">Check FAQ on Feedback</a>
        <a asp-controller="Home" asp-action="Index" class="jt-btn jt-btn-outline">Back to Home</a>
    </div>
</div>
