@model JamesThew.ViewModels.ContentSearchViewModel
@using JamesThew.Models
@{
    ViewData["Title"] = "Recipes - Master Culinary Catalog";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
}

<!-- Fixed Catalog Background Layer (Family A - Catalog) -->
<div class="jt-page-backdrop" aria-hidden="true">
    <div class="jt-page-bg-img" style="background-image: url('@Url.Content("~/assets/inner-pages/backgrounds/bg-catalog.webp")');"></div>
    <div class="jt-page-overlay"></div>
    <div class="jt-page-vignette"></div>
</div>

<div class="jt-inner-shell">
    <div class="jt-inner-container">

        <!-- Top Header & Search/Filter Controls -->
        <div class="jt-page-hero">
            <span class="jt-page-eyebrow">
                <span class="jt-eyebrow-line" aria-hidden="true"></span>
                Culinary Catalog
            </span>
            <h1 class="jt-page-title">Cookery <span class="jt-serif-italic">Recipes</span></h1>
            <p class="jt-page-lead">
                Browse foundational everyday favorites and fine-dining masterclasses created by Chef James Thew.
            </p>
        </div>

        <!-- Search & Filter Capsule Bar -->
        <div class="jt-filter-bar mb-5">
            <form asp-controller="Recipes" asp-action="Index" method="get" class="jt-search-form">
                <input type="search" name="q" value="@Model.Query" class="jt-search-input" placeholder="Search by recipe title or summary..." aria-label="Search recipes" />
                @if (Model.Visibility.HasValue)
                {
                    <input type="hidden" name="visibility" value="@Model.Visibility" />
                }
                <button type="submit" class="jt-search-btn">Search</button>
                @if (!string.IsNullOrEmpty(Model.Query))
                {
                    <a asp-controller="Recipes" asp-action="Index" asp-route-visibility="@Model.Visibility" class="jt-filter-pill text-light-muted">Clear</a>
                }
            </form>

            <div class="jt-filter-pills">
                <a asp-controller="Recipes" asp-action="Index" asp-route-q="@Model.Query"
                   class="jt-filter-pill @(Model.Visibility == null ? "active" : "")">
                    All (@Model.TotalItems)
                </a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-q="@Model.Query" asp-route-visibility="@ContentVisibility.Free"
                   class="jt-filter-pill @(Model.Visibility == ContentVisibility.Free ? "active" : "")">
                    Free Only
                </a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-q="@Model.Query" asp-route-visibility="@ContentVisibility.MembersOnly"
                   class="jt-filter-pill @(Model.Visibility == ContentVisibility.MembersOnly ? "active" : "")">
                    Members-Only
                </a>
            </div>
        </div>

        @if (Model.Recipes.Count == 0)
        {
            <!-- Empty State -->
            <div class="jt-glass-panel text-center p-5 my-5">
                <div class="display-6 text-warning mb-3">&#128269;</div>
                <h3 class="h4 jt-serif text-light">No matching recipes found</h3>
                <p class="text-light-secondary max-w-500 mx-auto mb-4">
                    We couldn't find any recipes matching your criteria. Try adjusting your search keywords or resetting filters.
                </p>
                <a asp-controller="Recipes" asp-action="Index" class="jt-btn-editorial jt-btn-outline-light jt-btn-sm">Reset All Filters</a>
            </div>
        }
        else
        {
            <!-- =========================================================================
                 GSAP PINNED STACKED-CARD SHOWCASE (Mirrors cards-animation.mp4)
                 Desktop: Pinned stage with sequential card translations, ambient glow, and scrubber
                 Mobile: Fluid vertical card cards without pin trapping
                 ========================================================================= -->
            <div class="jt-deck-showcase-section mb-5">
                <div class="jt-deck-showcase-pinned">
                    <div class="jt-deck-layout">

                        <!-- Left Flank: Editorial Context & Scrubber -->
                        <div class="jt-deck-flank">
                            <span class="jt-page-eyebrow">
                                <span class="jt-eyebrow-line" aria-hidden="true"></span>
                                Featured Selection
                            </span>
                            <h2 class="h2 jt-serif text-light mb-3">
                                Sequential <span class="jt-serif-italic">Masterclass Deck</span>
                            </h2>
                            <p class="text-light-secondary small mb-4 lh-lg">
                                Scroll down vertically to advance through our featured culinary recipes. Each formulation balances classic gastronomy, knife precision, and artisanal technique.
                            </p>

                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 px-3 py-1 font-monospace small">
                                    Showing @Model.Recipes.Count of @Model.TotalItems Recipe@(Model.TotalItems == 1 ? "" : "s")
                                </span>
                            </div>

                            <!-- Scrubber Progress Bar & Counter -->
                            <div class="jt-deck-counter">
                                <span class="jt-counter-index">01</span>
                                <div class="jt-counter-bar">
                                    <div class="jt-counter-bar-fill"></div>
                                </div>
                                <span class="jt-counter-total">/ @Model.Recipes.Count.ToString("D2")</span>
                            </div>
                        </div>

                        <!-- Right/Center: Stacked 3D Cards Stage -->
                        <div class="jt-deck-stage">
                            <!-- Dynamic Ambient Colored Glow (Updates as active card advances) -->
                            <div class="jt-deck-ambient-glow" aria-hidden="true"></div>

                            <!-- Cards Deck Stack -->
                            @for (int i = 0; i < Model.Recipes.Count; i++)
                            {
                                var recipe = Model.Recipes[i];
                                <article class="jt-deck-card" data-card-index="@i">
                                    <!-- Media Area -->
                                    <div class="jt-deck-card-media">
                                        @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                                        {
                                            <img src="@recipe.ImageUrl" alt="@recipe.Title" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="jt-fallback-artwork">
                                                <span class="fs-1 text-warning mb-2" aria-hidden="true">&#127859;</span>
                                                <span class="small font-monospace text-light-muted">Chef James Thew Formula</span>
                                            </div>
                                        }

                                        <!-- Card Badges -->
                                        <div class="jt-deck-card-badges">
                                            @if (recipe.IsMembersOnly)
                                            {
                                                <span class="jt-deck-badge jt-deck-badge-gold">&#128274; Members-Only</span>
                                            }
                                            else
                                            {
                                                <span class="jt-deck-badge">Free Recipe</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Card Content Body -->
                                    <div class="jt-deck-card-body">
                                        <div class="jt-deck-card-meta">
                                            <span>&#128100; @recipe.AuthorDisplayName</span>
                                            @if (recipe.PrepMinutes.HasValue || recipe.CookMinutes.HasValue)
                                            {
                                                <span>&#9201; @((recipe.PrepMinutes ?? 0) + (recipe.CookMinutes ?? 0)) mins</span>
                                            }
                                            @if (recipe.Servings.HasValue)
                                            {
                                                <span>&#127860; @recipe.Servings portions</span>
                                            }
                                        </div>

                                        <h3 class="jt-deck-card-title">
                                            <a asp-controller="Recipes" asp-action="Detail" asp-route-slug="@recipe.Slug">
                                                @recipe.Title
                                            </a>
                                        </h3>

                                        <p class="jt-deck-card-desc">
                                            @recipe.Summary
                                        </p>

                                        <div class="jt-deck-card-action">
                                            <a asp-controller="Recipes" asp-action="Detail" asp-route-slug="@recipe.Slug" class="jt-btn-editorial jt-btn-gold jt-btn-sm">
                                                <span>Explore Recipe</span>
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>

                    </div>
                </div>
            </div>

            <!-- Complete Catalog Grid (For standard overview and pagination) -->
            <div class="mt-5 pt-4 border-top border-secondary border-opacity-25">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="h4 jt-serif text-light mb-0">Complete Recipe Catalog</h3>
                    <span class="small text-light-muted">Page @Model.Page of @Model.TotalPages</span>
                </div>

                <div class="row g-4 mb-5">
                    @foreach (var recipe in Model.Recipes)
                    {
                        <div class="col-md-6 col-lg-4">
                            <article class="jt-glass-panel jt-card-interactive-content jt-card-flip-wrap p-0 h-100 position-relative">
                                <div class="jt-card-spotlight" aria-hidden="true"></div>
                                <div class="jt-card-flip-inner">
                                    <!-- Front Face: Image, Title, Metadata, CTA -->
                                    <div class="jt-card-front d-flex flex-column h-100 overflow-hidden">
                                        <div class="jt-card-img-wrap position-relative" style="height: 220px;">
                                            @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                                            {
                                                <img src="@recipe.ImageUrl" alt="@recipe.Title" class="w-100 h-100 object-fit-cover" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="jt-fallback-artwork">
                                                    <span class="fs-1 text-warning mb-2" aria-hidden="true">&#127859;</span>
                                                    <span class="small font-monospace text-light-muted">Chef James Thew Formula</span>
                                                </div>
                                            }
                                            <div class="position-absolute top-0 start-0 m-3">
                                                @if (recipe.IsMembersOnly)
                                                {
                                                    <span class="badge bg-warning text-dark px-3 py-1 font-monospace">&#128274; Members-Only</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-dark bg-opacity-75 text-light border border-secondary border-opacity-50 px-3 py-1">Free Public</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                                            <div>
                                                <div class="d-flex align-items-center justify-content-between gap-2 text-light-muted small mb-2">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <span>&#128100; @recipe.AuthorDisplayName</span>
                                                        @if (recipe.PrepMinutes.HasValue || recipe.CookMinutes.HasValue)
                                                        {
                                                            <span>&#9201; @((recipe.PrepMinutes ?? 0) + (recipe.CookMinutes ?? 0))m</span>
                                                        }
                                                    </div>
                                                    <button type="button" class="jt-flip-toggle-btn" aria-label="Flip card for formula details" title="Peek formula details">
                                                        <span>Details</span> &circlearrowright;
                                                    </button>
                                                </div>
                                                <h4 class="h5 jt-serif mb-2">
                                                    <a asp-controller="Recipes" asp-action="Detail" asp-route-slug="@recipe.Slug" class="text-light text-decoration-none">
                                                        @recipe.Title
                                                    </a>
                                                </h4>
                                                <p class="small text-light-secondary line-clamp-2 mb-3">
                                                    @recipe.Summary
                                                </p>
                                            </div>
                                            <a asp-controller="Recipes" asp-action="Detail" asp-route-slug="@recipe.Slug" class="jt-btn-editorial jt-btn-outline-light jt-btn-sm text-center">
                                                <span>@(recipe.IsMembersOnly ? "View Preview" : "View Recipe")</span> <span class="jt-cta-arrow">&rarr;</span>
                                            </a>
                                        </div>
                                    </div>

                                    <!-- Back Face: Short Summary, Authentic Metadata, Explore CTA -->
                                    <div class="jt-card-back d-flex flex-column justify-content-between h-100 p-4">
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom border-secondary border-opacity-25">
                                                <span class="jt-badge-gold-pill">&#127859; Culinary Formula</span>
                                                <button type="button" class="jt-flip-close-btn" aria-label="Return to card overview" title="Close details">
                                                    &times;
                                                </button>
                                            </div>
                                            <h4 class="h6 jt-serif text-warning mb-2">@recipe.Title</h4>
                                            <p class="small text-light-secondary lh-base mb-3">@recipe.Summary</p>
                                            <div class="p-2 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-25 small mb-3">
                                                <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                                                    <span class="text-light-muted">Chef Author:</span>
                                                    <span class="text-light">@recipe.AuthorDisplayName</span>
                                                </div>
                                                @if (recipe.PrepMinutes.HasValue || recipe.CookMinutes.HasValue)
                                                {
                                                    <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25">
                                                        <span class="text-light-muted">Total Time:</span>
                                                        <span class="text-light">@((recipe.PrepMinutes ?? 0) + (recipe.CookMinutes ?? 0)) mins</span>
                                                    </div>
                                                }
                                                @if (recipe.Servings.HasValue)
                                                {
                                                    <div class="d-flex justify-content-between py-1">
                                                        <span class="text-light-muted">Portions:</span>
                                                        <span class="text-light">@recipe.Servings portions</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            <a asp-controller="Recipes" asp-action="Detail" asp-route-slug="@recipe.Slug" class="jt-btn-editorial jt-btn-gold jt-btn-sm w-100 text-center mb-2">
                                                <span>Explore Formula</span> <span class="jt-cta-arrow">&rarr;</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Recipe pagination" class="d-flex justify-content-center my-5">
                        <ul class="pagination pagination-dark gap-2">
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="jt-filter-pill @(p == Model.Page ? "active" : "")"
                                       asp-controller="Recipes" asp-action="Index"
                                       asp-route-page="@p"
                                       asp-route-q="@Model.Query"
                                       asp-route-visibility="@Model.Visibility">@p</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        }

    </div>
</div>

@section Scripts {
    <!-- GSAP CDN for Pinned Card Deck Choreography -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script src="~/js/public-pages.js" asp-append-version="true"></script>
}
