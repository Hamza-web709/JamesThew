@model JamesThew.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
}

<div class="jt-page-backdrop" aria-hidden="true">
    <div class="jt-page-bg-img" style="background-image: url('@Url.Content("~/assets/inner-pages/backgrounds/bg-account.webp")');"></div>
    <div class="jt-page-overlay"></div>
    <div class="jt-page-vignette"></div>
</div>

<div class="jt-inner-shell">
    <div class="jt-inner-container-sm">

        <!-- Page Header -->
        <div class="jt-page-hero">
            <span class="jt-page-eyebrow">
                <span class="jt-eyebrow-line" aria-hidden="true"></span>
                Culinary Sanctuary Security
            </span>
            <h1 class="jt-page-title">Set New <span class="jt-serif-italic">Password</span></h1>
            <p class="jt-page-lead">
                Choose a secure password of at least 12 characters including uppercase, lowercase, numbers, and symbols.
            </p>
        </div>

        <!-- Glass Auth Card -->
        <div class="jt-glass-panel jt-glass-panel-pinnacle jt-form-card jt-card-interactive-utility position-relative">
            <div class="jt-card-spotlight" aria-hidden="true"></div>

            <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="jt-validation-summary" role="alert"></div>
                <input asp-for="Token" type="hidden" />

                <div class="jt-form-group">
                    <label asp-for="NewPassword" class="jt-form-label">New Password</label>
                    <input asp-for="NewPassword" class="jt-form-input" autocomplete="new-password" placeholder="••••••••••••" autofocus />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="jt-form-group">
                    <label asp-for="ConfirmPassword" class="jt-form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="jt-form-input" autocomplete="new-password" placeholder="••••••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="jt-btn-editorial jt-btn-gold w-100 mt-2">
                    <span>Save New Password</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>

                <div class="jt-auth-links">
                    <span>Remember your existing password?</span>
                    <a asp-action="Login">Return to Sign In &rarr;</a>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/public-pages.js" asp-append-version="true"></script>
}
