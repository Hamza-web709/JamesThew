@{
    ViewData["Title"] = "Password Changed";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
}

<div class="jt-page-backdrop" aria-hidden="true">
    <div class="jt-page-bg-img" style="background-image: url('@Url.Content("~/assets/inner-pages/backgrounds/bg-account.webp")');"></div>
    <div class="jt-page-overlay"></div>
    <div class="jt-page-vignette"></div>
</div>

<div class="jt-inner-shell">
    <div class="jt-inner-container-sm">

        <!-- Page Header -->
        <div class="jt-page-hero">
            <span class="jt-page-eyebrow">
                <span class="jt-eyebrow-line" aria-hidden="true"></span>
                Security Confirmation
            </span>
            <h1 class="jt-page-title">Password Successfully <span class="jt-serif-italic">Changed</span></h1>
            <p class="jt-page-lead">
                Your credentials have been securely updated. You may now sign in using your new password.
            </p>
        </div>

        <!-- Glass Auth Card -->
        <div class="jt-glass-panel jt-glass-panel-pinnacle jt-form-card jt-card-interactive-utility position-relative text-center">
            <div class="jt-card-spotlight" aria-hidden="true"></div>

            <div class="mb-4 d-inline-flex align-items-center justify-content-center" style="width: 56px; height: 56px; border-radius: 50%; background: rgba(212, 175, 55, 0.15); border: 1px solid rgba(212, 175, 55, 0.3); color: var(--jt-gold-primary);">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>

            <h2 class="h4 mb-2" style="font-family: Georgia, serif; color: var(--jt-text-light-primary);">Password successfully changed.</h2>
            <p class="mb-4" style="color: var(--jt-text-light-secondary); font-size: 0.9375rem;">
                For your protection, sign in with your email and new password. You will receive a sign-in verification code to complete authentication.
            </p>

            <a asp-controller="Account" asp-action="Login" class="jt-btn-editorial jt-btn-gold w-100">
                <span>Sign In</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/public-pages.js" asp-append-version="true"></script>
}
