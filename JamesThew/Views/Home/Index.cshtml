@model JamesThew.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home - Master Chef Recipes & Culinary Secrets";
}

<section class="jt-hero">
    <div class="jt-hero-content">
        <span class="jt-hero-pretitle">Welcome to the Kitchen of</span>
        <h1 class="jt-hero-title">Master Chef James Thew</h1>
        <p class="jt-hero-desc">
            Discover a world of classical gastronomy, time-tested culinary techniques, and handcrafted recipes. From essential everyday dishes to fine-dining masterclasses, master the craft of cooking with confidence.
        </p>

        <div class="jt-hero-actions">
            <a asp-controller="Recipes" asp-action="Index" class="jt-btn jt-btn-primary">Browse Recipes</a>
            <a asp-controller="Tips" asp-action="Index" class="jt-btn jt-btn-outline">Cooking Tips</a>
            <a asp-controller="Faq" asp-action="Index" class="jt-btn jt-btn-secondary">How It Works</a>
        </div>

        <form asp-controller="Recipes" asp-action="Index" method="get" class="jt-hero-search">
            <div class="jt-search-form">
                <input type="search" name="q" class="jt-search-input" placeholder="Search roast chicken, sourdough, risotto..." aria-label="Search recipes and tips" />
                <button type="submit" class="jt-btn jt-btn-primary">Search</button>
            </div>
        </form>
    </div>

    <div class="jt-hero-media">
        <img src="~/images/hero/james-thew-kitchen.jpg" alt="Chef James Thew preparing culinary dishes in a professional kitchen" class="jt-hero-img" width="800" height="600" />
    </div>
</section>

<!-- Featured Recipes Section -->
<section class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
        <div>
            <span class="jt-brand-tag">Gastronomic Selection</span>
            <h2 class="mb-1">Featured Cookery Recipes</h2>
            <p class="text-muted mb-0">Carefully curated recipes with exact ingredients and step-by-step techniques.</p>
        </div>
        <a asp-controller="Recipes" asp-action="Index" class="jt-btn jt-btn-outline jt-btn-sm mt-2 mt-md-0">View All Recipes (@Model.TotalRecipesCount) &rarr;</a>
    </div>

    <div class="jt-card-grid">
        @foreach (var recipe in Model.FeaturedRecipes)
        {
            <article class="jt-card">
                <div class="jt-card-img-wrapper">
                    @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                    {
                        <img src="@recipe.ImageUrl" alt="@recipe.Title" class="jt-card-img" loading="lazy" />
                    }
                    <div class="jt-card-badge-pos">
                        @if (recipe.IsMembersOnly)
                        {
                            <span class="jt-badge jt-badge-paid">&#128274; Members-Only</span>
                        }
                        else
                        {
                            <span class="jt-badge jt-badge-free">Free Recipe</span>
                        }
                    </div>
                </div>
                <div class="jt-card-body">
                    <div class="jt-card-meta">
                        <span>&#128100; @recipe.AuthorDisplayName</span>
                        @if (recipe.PrepMinutes.HasValue || recipe.CookMinutes.HasValue)
                        {
                            <span>&#9201; @((recipe.PrepMinutes ?? 0) + (recipe.CookMinutes ?? 0)) mins total</span>
                        }
                        @if (recipe.Servings.HasValue)
                        {
                            <span>&#127860; @recipe.Servings servings</span>
                        }
                    </div>
                    <h3 class="jt-card-title">
                        <a asp-controller="Recipes" asp-action="Detail" asp-route-slug="@recipe.Slug">@recipe.Title</a>
                    </h3>
                    <p class="jt-card-text">@recipe.Summary</p>
                    <div class="jt-card-footer">
                        <a asp-controller="Recipes" asp-action="Detail" asp-route-slug="@recipe.Slug" class="jt-btn jt-btn-outline jt-btn-sm">
                            @(recipe.IsMembersOnly ? "View Preview" : "View Recipe") &rarr;
                        </a>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

<!-- Featured Tips Section -->
<section class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
        <div>
            <span class="jt-brand-tag">Kitchen Wisdom</span>
            <h2 class="mb-1">Culinary Secrets &amp; Cooking Tips</h2>
            <p class="text-muted mb-0">Professional advice on knife mastery, pan kinetics, and classical flavor balance.</p>
        </div>
        <a asp-controller="Tips" asp-action="Index" class="jt-btn jt-btn-outline jt-btn-sm mt-2 mt-md-0">View All Tips (@Model.TotalTipsCount) &rarr;</a>
    </div>

    <div class="jt-card-grid">
        @foreach (var tip in Model.FeaturedTips)
        {
            <article class="jt-card">
                <div class="jt-card-img-wrapper">
                    @if (!string.IsNullOrEmpty(tip.ImageUrl))
                    {
                        <img src="@tip.ImageUrl" alt="@tip.Title" class="jt-card-img" loading="lazy" />
                    }
                    <div class="jt-card-badge-pos">
                        @if (tip.IsMembersOnly)
                        {
                            <span class="jt-badge jt-badge-paid">&#128274; Masterclass Secret</span>
                        }
                        else
                        {
                            <span class="jt-badge jt-badge-free">Free Tip</span>
                        }
                    </div>
                </div>
                <div class="jt-card-body">
                    <div class="jt-card-meta">
                        <span>&#128100; @tip.AuthorDisplayName</span>
                        <span>&#128197; @tip.CreatedAtUtc.ToString("MMM dd, yyyy")</span>
                    </div>
                    <h3 class="jt-card-title">
                        <a asp-controller="Tips" asp-action="Detail" asp-route-slug="@tip.Slug">@tip.Title</a>
                    </h3>
                    <p class="jt-card-text">@tip.Summary</p>
                    <div class="jt-card-footer">
                        <a asp-controller="Tips" asp-action="Detail" asp-route-slug="@tip.Slug" class="jt-btn jt-btn-outline jt-btn-sm">
                            @(tip.IsMembersOnly ? "View Preview" : "Read Full Tip") &rarr;
                        </a>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

<!-- Membership & Value Proposition Section -->
<section class="mb-5 p-4 p-md-5 rounded-4" style="background: linear-gradient(135deg, #FAF4EB 0%, #F5EDE0 100%); border: 1px solid var(--jt-border);">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <span class="jt-brand-tag">Culinary Masterclasses</span>
            <h2 class="mb-3">Unlock James Thew's Exclusive Culinary Secrets</h2>
            <p class="lead mb-4" style="color: var(--jt-text-muted);">
                While our foundational recipes and kitchen tips are open to all visitors, our most intricate fine-dining masterclasses—such as Beef Wellington, Lobster Thermidor, and French pan emulsion sauces—are reserved for registered members.
            </p>
            <div class="d-flex flex-wrap gap-3 mb-3">
                <div class="p-3 bg-white rounded-3 border" style="min-width: 180px;">
                    <span class="d-block text-muted small text-uppercase fw-bold">Demo Monthly</span>
                    <strong class="fs-4 text-danger">$10</strong> <span class="text-muted">/ month</span>
                    <div class="small text-muted mt-1">Full masterclass catalog</div>
                </div>
                <div class="p-3 bg-white rounded-3 border" style="min-width: 180px;">
                    <span class="d-block text-muted small text-uppercase fw-bold">Demo Annual</span>
                    <strong class="fs-4 text-danger">$100</strong> <span class="text-muted">/ year</span>
                    <div class="small text-muted mt-1">Save $20 over monthly</div>
                </div>
            </div>
            <p class="small text-muted mb-4">
                <em>* Note: Simulated academic demonstration project. Subscriptions are processed via administrative demo approval; no real financial charges or credit card payments occur.</em>
            </p>
            <a asp-controller="Account" asp-action="Register" class="jt-btn jt-btn-primary">Register Free Account</a>
            <a asp-controller="Faq" asp-action="Index" class="jt-btn jt-btn-outline ms-2">Membership Details</a>
        </div>
        <div class="col-lg-5 mt-4 mt-lg-0 text-center">
            <img src="~/images/recipes/beef-wellington.jpg" alt="Masterclass Beef Wellington" class="img-fluid rounded-4 shadow-sm border border-4 border-white" style="max-height: 340px; object-fit: cover;" />
        </div>
    </div>
</section>

<!-- Community Contests & Announcements Teaser -->
<section class="mb-5">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="p-4 bg-white rounded-4 border h-100 shadow-sm d-flex flex-column">
                <span class="jt-brand-tag">Culinary Competitions</span>
                <h3 class="mb-2">Seasonal Recipe &amp; Tip Contests</h3>
                <p class="text-muted flex-grow-1">
                    James Thew hosts seasonal themed cooking competitions for home cooks and food enthusiasts. Browse contest criteria, test your culinary creativity, and compete for culinary recognition.
                </p>
                <div class="mt-3">
                    <a asp-controller="Contests" asp-action="Index" class="jt-btn jt-btn-outline jt-btn-sm">Explore Contests &rarr;</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-4 bg-white rounded-4 border h-100 shadow-sm d-flex flex-column">
                <span class="jt-brand-tag">Hall of Fame</span>
                <h3 class="mb-2">Winner Announcements</h3>
                <p class="text-muted flex-grow-1">
                    Celebrate standout culinary creations. Each contest concludes with a formal announcement of the winning member and an in-depth breakdown of what made their post extraordinary.
                </p>
                <div class="mt-3">
                    <a asp-controller="Announcements" asp-action="Index" class="jt-btn jt-btn-outline jt-btn-sm">View Winners &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quick FAQ Preview Section -->
<section class="mb-4">
    <div class="text-center max-w-700 mx-auto mb-4">
        <span class="jt-brand-tag">Clear Answers</span>
        <h2>Frequently Asked Questions</h2>
        <p class="text-muted">Common questions regarding guest access, membership tiers, submissions, and contest rules.</p>
    </div>

    <div class="jt-faq-list">
        @foreach (var faq in Model.QuickFaqs)
        {
            <details class="jt-faq-item" id="@faq.QuestionKey">
                <summary class="jt-faq-summary">@faq.Question</summary>
                <div class="jt-faq-answer">
                    <p class="mb-0">@faq.Answer</p>
                </div>
            </details>
        }
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Faq" asp-action="Index" class="jt-btn jt-btn-secondary">View All 7 Official FAQ Answers &rarr;</a>
    </div>
</section>
