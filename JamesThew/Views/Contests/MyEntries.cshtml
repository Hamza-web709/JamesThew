@model JamesThew.ViewModels.MyContestEntriesViewModel
@using JamesThew.Models
@{
    ViewData["Title"] = "My Contest Entries - James Thew";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
}

<div class="jt-page-backdrop" aria-hidden="true">
    <div class="jt-page-bg-img" style="background-image: url('@Url.Content("~/assets/inner-pages/backgrounds/bg-catalog.webp")');"></div>
    <div class="jt-page-overlay"></div>
    <div class="jt-page-vignette"></div>
</div>

<div class="jt-inner-shell jt-member-page">
    <div class="jt-inner-container">


<div class="mb-5 max-w-900 mx-auto">
    <!-- Breadcrumbs -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Index" class="jt-member-back-link text-decoration-none small">
            &larr; Back to all competitions
        </a>
        <a asp-controller="Account" asp-action="Status" class="jt-member-back-link text-decoration-none small">
            My Account &rarr;
        </a>
    </div>

    <!-- Page Header -->
    <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm mb-4 jt-glass-panel jt-member-panel jt-card-interactive-utility position-relative"><div class="jt-card-spotlight" aria-hidden="true"></div>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
            <div>
                <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1 mb-2">
                    &#127942; Member Competitions
                </span>
                <h1 class="jt-page-title jt-serif mb-1">My Contest Entries</h1>
                <p class="text-muted mb-0">
                    Track your competition submissions, review jury status, and refine your dishes before submission deadlines.
                </p>
            </div>
            <div>
                <a asp-action="Index" class="jt-btn-editorial jt-btn-gold btn-sm">
                    Browse Competitions &rarr;
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            &#10004; @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.TotalCount == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm p-4 jt-glass-panel jt-member-panel jt-card-interactive-utility position-relative"><div class="jt-card-spotlight" aria-hidden="true"></div>
            <div class="fs-1 mb-3">&#127859;</div>
            <h2 class="h4 jt-serif mb-2">No competition entries yet</h2>
            <p class="text-muted max-w-500 mx-auto mb-4">
                You haven't submitted any recipes or cooking tips to Chef James Thew's competitions yet. Discover open competitions and showcase your culinary talent!
            </p>
            <a asp-action="Index" class="jt-btn-editorial jt-btn-gold px-4 py-2">
                Discover Open Competitions &rarr;
            </a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted small">
                Showing <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "entry" : "entries")
            </span>
            <span class="small text-muted font-monospace">
                &#128274; Entries are private to you and the jury
            </span>
        </div>

        <div class="row g-3">
            @foreach (var entry in Model.Entries)
            {
                <div class="col-12">
                    <div class="card border rounded-4 shadow-sm p-3 p-md-4 h-100 bg-white jt-glass-panel jt-member-panel jt-card-interactive-utility position-relative"><div class="jt-card-spotlight" aria-hidden="true"></div>
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (entry.ContestType == ContestType.Recipe)
                                {
                                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1 small">
                                        &#127859; Recipe
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border rounded-pill px-2 py-1 small">
                                        &#128161; Cooking Tip
                                    </span>
                                }

                                @if (entry.TimelinePhase == ContestTimelinePhase.Open)
                                {
                                    <span class="badge bg-success rounded-pill px-2 py-1 small">
                                        &#9889; Contest Open
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-2 py-1 small">
                                        &#128274; Contest Concluded
                                    </span>
                                }

                                @if (entry.IsWinnerAnnounced)
                                {
                                    <span class="badge bg-warning text-dark border border-warning-subtle rounded-pill px-2 py-1 small fw-bold">
                                        &#127942; Winner Announced!
                                    </span>
                                }
                                else if (entry.Status == ContestEntryStatus.Selected)
                                {
                                    <span class="badge bg-success rounded-pill px-2 py-1 small fw-bold">
                                        &#127942; Winner Selected
                                    </span>
                                }
                                else if (entry.Status == ContestEntryStatus.UnderReview)
                                {
                                    <span class="badge bg-info text-dark rounded-pill px-2 py-1 small">
                                        &#128269; Under Review
                                    </span>
                                }
                                else if (entry.Status == ContestEntryStatus.Disqualified)
                                {
                                    <span class="badge bg-danger rounded-pill px-2 py-1 small">
                                        &#10060; Disqualified
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                                        Status: Submitted
                                    </span>
                                }
                            </div>

                            <span class="text-muted small font-monospace">
                                Submitted @entry.SubmittedAtUtc.ToString("MMM d, yyyy HH:mm") UTC
                            </span>
                        </div>

                        <div class="mb-2">
                            <span class="small text-muted d-block">
                                Competition: <a asp-action="Detail" asp-route-slug="@entry.ContestSlug" class="fw-semibold text-decoration-none">@entry.ContestTitle</a>
                            </span>
                            <h3 class="h5 jt-serif mt-1 mb-1">@entry.EntryTitle</h3>
                            <p class="text-muted small mb-0">@entry.Summary</p>
                        </div>

                        @if (entry.UpdatedAtUtc.HasValue)
                        {
                            <div class="small text-muted font-monospace mb-2">
                                &#9998; Last updated @entry.UpdatedAtUtc.Value.ToString("MMM d, yyyy HH:mm") UTC
                            </div>
                        }

                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-3 mt-auto border-top">
                            <div class="small text-muted">
                                @if (entry.CanEdit)
                                {
                                    <span class="text-success">&#9889; Closes @entry.ClosesAtUtc.ToString("MMM d, yyyy HH:mm") UTC</span>
                                }
                                else if (entry.Status == ContestEntryStatus.UnderReview)
                                {
                                    <span class="text-info">&#128274; Under review by jury &bull; Editing locked</span>
                                }
                                else if (entry.Status == ContestEntryStatus.Selected)
                                {
                                    <span class="text-success fw-bold">&#127942; Selected as competition winner</span>
                                }
                                else if (entry.Status == ContestEntryStatus.Disqualified)
                                {
                                    <span class="text-danger">&#10060; Disqualified from competition</span>
                                    @if (!string.IsNullOrWhiteSpace(entry.DisqualificationReason))
                                    {
                                        <div class="small text-danger mt-1">Reason: @entry.DisqualificationReason</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary">&#128274; Deadline passed - read only</span>
                                }
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-action="MyEntryDetail" asp-route-slug="@entry.ContestSlug" class="jt-btn-editorial jt-btn-outline-light jt-btn-sm">
                                    View Full Entry &rarr;
                                </a>

                                @if (entry.CanEdit)
                                {
                                    <a asp-action="Entry" asp-route-slug="@entry.ContestSlug" class="jt-btn-editorial jt-btn-gold jt-btn-sm">
                                        &#9998; Edit Entry
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/public-pages.js" asp-append-version="true"></script>
}
