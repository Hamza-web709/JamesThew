@model JamesThew.ViewModels.ContestEntryFormViewModel
@using JamesThew.Models
@{
    var isEdit = Model.IsEdit;
    ViewData["Title"] = (isEdit ? "Edit Contest Entry" : "Submit Contest Entry") + $" - {Model.ContestTitle}";
}

<div class="max-w-800 mx-auto my-4">
    <!-- Breadcrumb & Back Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Detail" asp-route-slug="@Model.ContestSlug" class="text-decoration-none text-muted small">
            &larr; Back to Contest: @Model.ContestTitle
        </a>
        <a asp-action="MyEntries" class="text-decoration-none text-muted small">
            My Contest Entries &rarr;
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Card -->
    <div class="p-4 bg-white rounded-4 border shadow-sm mb-4">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            @if (Model.ContestType == ContestType.Recipe)
            {
                <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1">
                    &#127859; Recipe Competition
                </span>
            }
            else
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border rounded-pill px-3 py-1">
                    &#128161; Cooking Tip Competition
                </span>
            }

            @if (Model.IsReadonly)
            {
                <span class="badge bg-secondary rounded-pill px-3 py-1">
                    &#128274; Read-Only (Submissions Closed)
                </span>
            }
            else
            {
                <span class="badge bg-success rounded-pill px-3 py-1">
                    &#9889; Submissions Open (Closes @Model.ClosesAtUtc.ToString("MMM d, yyyy HH:mm") UTC)
                </span>
            }
        </div>

        <h1 class="h3 jt-serif mb-1">@(isEdit ? "Edit Your Competition Entry" : "Official Competition Entry")</h1>
        <p class="text-muted mb-0">
            Competition: <strong>@Model.ContestTitle</strong>
        </p>
    </div>

    @if (Model.IsReadonly)
    {
        <div class="alert alert-warning mb-4" role="alert">
            <h4 class="alert-heading h6 mb-1">&#128274; Submission Window Concluded</h4>
            <p class="small mb-0">
                The deadline for this competition has passed. Existing entries are preserved in read-only format for jury evaluation and cannot be modified.
            </p>
        </div>
    }

    <!-- Entry Form -->
    <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm mb-4">
        <form asp-action="Entry" asp-route-slug="@Model.ContestSlug" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ContestId" />
            <input type="hidden" asp-for="ContestTitle" />
            <input type="hidden" asp-for="ContestSlug" />
            <input type="hidden" asp-for="ContestType" />
            <input type="hidden" asp-for="ClosesAtUtc" />
            <input type="hidden" asp-for="EntryId" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <!-- Title & Summary -->
            <div class="mb-4">
                <label asp-for="Title" class="form-label fw-semibold">
                    Entry Title <span class="text-danger">*</span>
                </label>
                <input asp-for="Title" class="form-control" placeholder="@(Model.ContestType == ContestType.Recipe ? "e.g., Braised Short Ribs with Autumn Root Puree" : "e.g., Japanese Honing Steel Mastery")" disabled="@(Model.IsReadonly ? "disabled" : null)" />
                <span asp-validation-for="Title" class="text-danger small"></span>
                <div class="form-text">Choose a descriptive and culinary-focused title (3 to 150 characters).</div>
            </div>

            <div class="mb-4">
                <label asp-for="Summary" class="form-label fw-semibold">
                    Summary Teaser <span class="text-danger">*</span>
                </label>
                <textarea asp-for="Summary" class="form-control" rows="3" placeholder="A concise 1-2 sentence overview of your dish or technique (10 to 500 characters)." disabled="@(Model.IsReadonly ? "disabled" : null)"></textarea>
                <span asp-validation-for="Summary" class="text-danger small"></span>
            </div>

            @if (Model.ContestType == ContestType.Recipe)
            {
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <h2 class="h6 jt-serif mb-3 text-primary">&#127859; Recipe Details &amp; Formulation</h2>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Servings" class="form-label small fw-semibold">Servings</label>
                            <input asp-for="Servings" type="number" class="form-control" placeholder="4" min="1" max="100" disabled="@(Model.IsReadonly ? "disabled" : null)" />
                            <span asp-validation-for="Servings" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PrepMinutes" class="form-label small fw-semibold">Prep Time (min)</label>
                            <input asp-for="PrepMinutes" type="number" class="form-control" placeholder="30" min="0" max="1440" disabled="@(Model.IsReadonly ? "disabled" : null)" />
                            <span asp-validation-for="PrepMinutes" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CookMinutes" class="form-label small fw-semibold">Cook Time (min)</label>
                            <input asp-for="CookMinutes" type="number" class="form-control" placeholder="90" min="0" max="1440" disabled="@(Model.IsReadonly ? "disabled" : null)" />
                            <span asp-validation-for="CookMinutes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IngredientsText" class="form-label fw-semibold">
                            Ingredients (one per line) <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="IngredientsText" class="form-control font-monospace" rows="6" placeholder="800g Prime Beef Chuck, cut into 2-inch cubes&#10;2 tbsp Extra Virgin Olive Oil&#10;3 large Carrots, peeled and sliced&#10;1 tsp Coarse Sea Salt" disabled="@(Model.IsReadonly ? "disabled" : null)"></textarea>
                        <span asp-validation-for="IngredientsText" class="text-danger small"></span>
                        <div class="form-text">Include quantities, units, and ingredient names separated by line breaks.</div>
                    </div>

                    <div class="mb-0">
                        <label asp-for="StepsText" class="form-label fw-semibold">
                            Preparation Steps (one per line) <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="StepsText" class="form-control font-monospace" rows="6" placeholder="Sear the beef in hot olive oil until deeply browned on all sides.&#10;Add chopped mirepoix vegetables and sweat for 8 minutes until fragrant.&#10;Pour in red wine and beef stock; cover and braise on low heat for 2.5 hours.&#10;Rest for 10 minutes before garnishing with fresh chopped parsley." disabled="@(Model.IsReadonly ? "disabled" : null)"></textarea>
                        <span asp-validation-for="StepsText" class="text-danger small"></span>
                        <div class="form-text">Write clear, sequential instructions. Each line becomes an ordered step.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <h2 class="h6 jt-serif mb-3 text-warning-emphasis">&#128161; Technique &amp; Culinary Wisdom</h2>

                    <div class="mb-0">
                        <label asp-for="TipBody" class="form-label fw-semibold">
                            Technique Description &amp; Instructions <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="TipBody" class="form-control" rows="8" placeholder="Describe the culinary method, why it works scientifically, and the exact steps for safe home kitchen execution (10 to 10,000 characters)." disabled="@(Model.IsReadonly ? "disabled" : null)"></textarea>
                        <span asp-validation-for="TipBody" class="text-danger small"></span>
                    </div>
                </div>
            }

            <!-- Author Remarks & Optional Image -->
            <div class="mb-4">
                <label asp-for="Notes" class="form-label fw-semibold">
                    Author Remarks / Culinary Context (optional)
                </label>
                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Any personal story, origin inspiration, or pairing recommendations for the jury." disabled="@(Model.IsReadonly ? "disabled" : null)"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ImageUrl" class="form-label fw-semibold">
                    Optional Photo URL
                </label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/my-dish.jpg" disabled="@(Model.IsReadonly ? "disabled" : null)" />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                <div class="form-text">External image URL showcasing your finished recipe or knife setup. Note: Direct file uploads to server storage are restricted to editorial staff.</div>
            </div>

            <!-- Submit Buttons -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top">
                <a asp-action="Detail" asp-route-slug="@Model.ContestSlug" class="btn btn-outline-secondary">
                    &larr; Cancel &amp; Back to Contest
                </a>

                @if (!Model.IsReadonly)
                {
                    <button type="submit" id="btnSubmitContestEntry" class="btn btn-primary px-4 py-2">
                        @(isEdit ? "Update Contest Entry" : "Submit Official Contest Entry") &rarr;
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary px-4 py-2" disabled>
                        &#128274; Submissions Concluded
                    </button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
